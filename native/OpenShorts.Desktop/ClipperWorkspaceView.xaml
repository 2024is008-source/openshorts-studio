<UserControl x:Class="OpenShorts.Desktop.ClipperWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" SizeChanged="OnLayoutSizeChanged">
 <Grid>
  <Viewbox x:Name="ProcessingFit" Visibility="{Binding ClipperProcessing,Converter={StaticResource Visible}}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top"><Grid x:Name="ProcessingSurface" Width="1480" Height="{Binding GenerationSurfaceHeight}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ProcessingSidebar" Width="282"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,12,0">
    <Border DockPanel.Dock="Top" Style="{StaticResource ClipPanel}" Margin="0,0,0,10" Padding="18,14"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1A2B"/><GradientStop Color="#002B3A" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="←  AI CLIPPER" Foreground="#7FCAE5" FontSize="9"/><TextBlock Text="{Binding GenerationTitle}" FontSize="26" FontWeight="Bold" Margin="0,6,0,6"/><TextBlock Text="{Binding GenerationDescription}" Style="{StaticResource ClipHint}"/></StackPanel><local:GenerationStepper Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Border>
    <Border DockPanel.Dock="Top" Style="{StaticResource ClipPanel}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Source Video" Style="{StaticResource ClipHeading}"/><DockPanel><Border DockPanel.Dock="Left" Width="180" Height="86" CornerRadius="7" Background="#07121C" Margin="0,0,18,0" ClipToBounds="True"><Image Source="{Binding GenerationThumbnail,Converter={StaticResource ClipThumbnail},IsAsync=True}" Stretch="UniformToFill"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GenerationSourceTitle}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding GenerationSourceDetails}" Style="{StaticResource ClipHint}" Margin="0,10,0,8"/><WrapPanel><Border Background="#073B2C" BorderBrush="#116347" BorderThickness="1" CornerRadius="12" Padding="8,4"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="circle-check" Width="14" Height="14" Stroke="#22C55E" Margin="0,0,6,0"/><TextBlock Text="{Binding GenerationSourceStatus}" Foreground="#22C55E" FontSize="10"/></StackPanel></Border><TextBlock Text="{Binding GenerationSourceHint}" Style="{StaticResource ClipHint}" Margin="12,5,0,0"/></WrapPanel></StackPanel></DockPanel></StackPanel></Border>
    <Border Style="{StaticResource ClipPanel}" Padding="14"><DockPanel>
     <WrapPanel x:Name="ProcessingActions" DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Command="{Binding CancelCommand}" Visibility="{Binding CancellationAvailable,Converter={StaticResource Visible}}" Style="{StaticResource ClipAction}" Foreground="#FF6576" BorderBrush="#DB4254" Background="#301A28"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="square" Width="13" Height="13" Stroke="#FF6576" Margin="0,0,7,0"/><TextBlock Text="Cancel Generation"/></StackPanel></Button><Button Command="{Binding RunGenerationBackgroundCommand}" Visibility="{Binding GenerationActive,Converter={StaticResource Visible}}" Style="{StaticResource ClipAction}" Foreground="#00D8EF"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="copy" Width="15" Height="15" Stroke="#00D8EF" Margin="0,0,7,0"/><TextBlock Text="Run in Background"/></StackPanel></Button><Button Command="{Binding ToggleGenerationDetailsCommand}" Style="{StaticResource ClipAction}"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="list" Width="15" Height="15" Stroke="#A7C9DE" Margin="0,0,7,0"/><TextBlock Text="View Details"/></StackPanel></Button><Button Content="Import video" Command="{Binding ImportCommand}" Style="{StaticResource ClipAction}"/><CheckBox Content="I have permission to process this video" IsChecked="{Binding Acknowledged}" Visibility="{Binding GenerationIdle,Converter={StaticResource Visible}}" Foreground="#C6D9E6" VerticalAlignment="Center" Margin="6,0,12,5"/><Button Content="Start AI clipping" Command="{Binding StartClippingCommand}" Visibility="{Binding GenerationIdle,Converter={StaticResource Visible}}" Style="{StaticResource ClipPrimary}"/><Button Content="Saved clips" Command="{Binding ShowSavedGenerationClipsCommand}" Style="{StaticResource ClipAction}"/></WrapPanel>
     <StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding GenerationStepCaption}" Foreground="#00D8EF" FontSize="10"/><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="sparkles" Width="18" Height="18" Stroke="#00D8EF" Margin="0,0,8,8"/><TextBlock Text="AI Processing Progress" Style="{StaticResource ClipHeading}"/></StackPanel></DockPanel>
      <Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Width="128" Height="128" HorizontalAlignment="Left"><Ellipse Stroke="#0A3E51" StrokeThickness="8"/><Ellipse Stroke="#00D8EF" StrokeThickness="8" StrokeDashArray="18 8" RenderTransformOrigin="0.5,0.5" Visibility="{Binding GenerationActive,Converter={StaticResource Visible}}"><Ellipse.Effect><DropShadowEffect Color="#00D8EF" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/></Ellipse.Effect><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding GenerationRingText}" FontSize="32" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="{Binding GenerationRingDetail}" Foreground="#39D8EF" FontSize="8" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel></Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,14,0"><TextBlock Text="{Binding GenerationStage}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Workflow progress · completed reported stages" Style="{StaticResource ClipHint}"/><ProgressBar Style="{StaticResource ClipProgress}" Value="{Binding GenerationStepsPercent,Mode=OneWay}" Margin="0,8,0,8"/><WrapPanel><StackPanel Orientation="Horizontal" Margin="0,6,20,0"><local:LucideIcon Kind="clock" Width="20" Height="20" Stroke="#8ACAE7" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Elapsed time" Foreground="#A7BED1" FontSize="10"/><TextBlock Text="{Binding GenerationElapsed}" FontWeight="SemiBold" FontSize="12"/></StackPanel></StackPanel><StackPanel Margin="0,6,0,0"><TextBlock Text="Estimated remaining" Foreground="#A7BED1" FontSize="10"/><TextBlock Text="Not measured" FontSize="12"/></StackPanel></WrapPanel></StackPanel>

      </Grid>
      <TextBlock Text="Processing Steps" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
      <ItemsControl x:Name="ProcessingStagesView" ItemsSource="{Binding GenerationStages}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#21394B" BorderThickness="0,0,0,1" Padding="7,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:LucideIcon Kind="{Binding Icon}" Width="15" Height="15" Stroke="{Binding Color}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#88A6BF" FontSize="10"/></Grid><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="10" Margin="12,0,14,0"/><TextBlock Text="{Binding PercentLabel}" Foreground="{Binding Color}" FontSize="10" Width="60" TextAlignment="Right"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Background="#35202C" CornerRadius="7" Padding="10" Margin="0,10,0,4" Visibility="{Binding GenerationHasFailure,Converter={StaticResource Visible}}"><TextBlock Text="{Binding GenerationFailure}" Foreground="#FFABB6" TextWrapping="Wrap"/></Border>
     </StackPanel>
    </DockPanel></Border>
   </DockPanel>
   <StackPanel Grid.Column="1">
    <Border Style="{StaticResource ClipPanel}" Padding="12,10"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Video options ›" Command="{Binding ReviewClippingSettingsCommand}" Style="{StaticResource ClipAction}" Padding="0" MinHeight="18" Background="Transparent" BorderThickness="0" Foreground="#00D8EF"/><TextBlock Text="Clip Generation Settings" FontSize="12" FontWeight="SemiBold"/></DockPanel><ItemsControl ItemsSource="{Binding GenerationSettingRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#263B4B" BorderThickness="0,0,0,1" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:LucideIcon Kind="{Binding Icon}" Width="20" Height="20" Stroke="#A5CDE4" VerticalAlignment="Top" Margin="0,7,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="#A8BED3" FontSize="10"/><TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#8CA9C0" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border x:Name="ProcessingSystem" Style="{StaticResource ClipPanel}" Margin="0,9,0,0" Padding="12"><StackPanel><TextBlock Text="System &amp; Performance" Style="{StaticResource ClipHeading}"/><TextBlock Text="AI Engine · Managed local worker" FontSize="11"/><Separator Margin="0,10"/><TextBlock Text="{Binding HomeGpuDetail}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding HomeGpuFeatures}" Style="{StaticResource ClipHint}"/><Separator Margin="0,8"/><DockPanel><local:LucideIcon Kind="memory-stick" Width="20" Height="20" Stroke="#A5CDE4" Margin="0,0,8,0"/><StackPanel><TextBlock Text="System Memory" FontSize="11"/><TextBlock Text="{Binding SystemMemory}" Style="{StaticResource ClipHint}"/></StackPanel></DockPanel><ProgressBar Value="{Binding SystemMemoryPercent}" Style="{StaticResource ClipProgress}" Height="4"/><TextBlock Text="Background processing continues while this app remains open." Style="{StaticResource ClipHint}"/></StackPanel></Border>
   </StackPanel>
  </Grid></Viewbox>
  <DockPanel Visibility="{Binding ClipperReview,Converter={StaticResource Visible}}">
   <Border DockPanel.Dock="Top" Style="{StaticResource ClipPanel}" Margin="0,0,0,9" Padding="16,12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111A30"/><GradientStop Color="#002C3D" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition x:Name="ReviewStepColumn" Width="0.85*"/><ColumnDefinition x:Name="CompletionColumn" Width="0.95*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AI CLIPPER    ›    RESULTS" FontSize="9" Foreground="#8DC9E0"/><WrapPanel Margin="0,8,0,5"><TextBlock Text="Generated Clips" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/><TextBlock Text="{Binding ReviewReadyLabel}" Foreground="#22C55E" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/></WrapPanel><TextBlock Text="Review, edit and export your favorite moments." Style="{StaticResource ClipHint}"/><TextBlock Text="{Binding GenerationSourceTitle}" FontSize="10" Foreground="#8DA9C1" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding GenerationWarning}" Foreground="#F2C778" FontSize="10" TextWrapping="Wrap" MaxHeight="32" ToolTip="{Binding GenerationWarning}"/></StackPanel><local:GenerationStepper x:Name="ReviewStepper" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0"/><Grid x:Name="CompletionContainer" Grid.Column="2"><Border Visibility="{Binding ReviewCompletionVisible,Converter={StaticResource Visible}}" Background="#043D3F" BorderBrush="#087F69" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Command="{Binding DismissReviewCompletionCommand}" Style="{StaticResource ClipAction}" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="14"><local:LucideIcon Kind="x" Width="12" Height="12" Stroke="#AAD1DD"/></Button><TextBlock Text="Your clips are ready for review" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding ReviewCount}" Foreground="#9FD6D3" FontSize="9" Margin="0,5,0,10"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="{Binding ReviewTotalTime}" FontWeight="SemiBold"/><TextBlock Text="Total clip duration" FontSize="8" Foreground="#9FD6D3"/></StackPanel><StackPanel><TextBlock Text="{Binding ReviewReadyLabel}" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Available outputs" FontSize="8" Foreground="#9FD6D3"/></StackPanel><StackPanel><TextBlock Text="{Binding ReviewSavedExports}" FontWeight="SemiBold"/><TextBlock Text="Exports" FontSize="8" Foreground="#9FD6D3"/></StackPanel></UniformGrid></StackPanel></Border></Grid></Grid></Border>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReviewNotice}" Foreground="#A7B4C7" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="1*" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.75*" MinWidth="300"/><ColumnDefinition x:Name="ReviewDivider" Width="8"/><ColumnDefinition x:Name="DetailsColumn" Width="282"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource ClipPanel}" Padding="10"><TabControl x:Name="PreviewTabs" Background="Transparent" BorderThickness="0"><TabItem Header="Preview"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,2,0,8"><Button DockPanel.Dock="Right" Command="{Binding NextReviewCommand}" Style="{StaticResource ClipAction}" Padding="4" Background="Transparent" BorderThickness="0"><local:LucideIcon Kind="chevron-right" Width="15" Height="15" Stroke="#A7C8DF"/></Button><TextBlock DockPanel.Dock="Right" Text="{Binding ReviewSelectionPosition}" Foreground="#A7C8DF" FontSize="11" Margin="5,5"/><Button DockPanel.Dock="Right" Command="{Binding PreviousReviewCommand}" Style="{StaticResource ClipAction}" Padding="4" Background="Transparent" BorderThickness="0"><local:LucideIcon Kind="chevron-left" Width="15" Height="15" Stroke="#A7C8DF"/></Button><TextBlock Text="Selected clip" Foreground="#B1CCDE" FontSize="11" VerticalAlignment="Center"/></DockPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding ReviewPreviewKind}" Style="{StaticResource ClipHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReviewPreviewKind}"/><Slider Style="{StaticResource ClipSlider}" x:Name="ReviewSeek" Minimum="{Binding ReviewSeekMinimum}" Maximum="{Binding ReviewSeekMaximum}" Value="{Binding SeekSeconds}" PreviewMouseLeftButtonUp="OnReviewSeek" Margin="0,5"/><WrapPanel><Button Command="{Binding ReviewPlayPauseCommand}" Style="{StaticResource ClipAction}" ToolTip="Play / pause"><local:LucideIcon Kind="Play" Width="18" Height="18" Stroke="White"/></Button><TextBlock Text="{Binding ReviewPlaybackClock}" VerticalAlignment="Center" FontSize="11" Margin="3,0,7,0"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewSpeeds}" SelectedItem="{Binding ReviewSpeed}" Width="55" FontSize="10" Margin="0,0,3,5" Padding="3"/><Button Click="OnFullscreen" Style="{StaticResource ClipAction}" ToolTip="Fullscreen · Esc to return" Margin="6,0,0,5"><local:LucideIcon Kind="Maximize" Width="16" Height="16" Stroke="#B8C5D5"/></Button></WrapPanel><DockPanel><local:LucideIcon Kind="Audio" Stroke="#A7B4C7" Width="16" Height="16" DockPanel.Dock="Left"/><Slider Style="{StaticResource ClipSlider}" Minimum="0" Maximum="100" Value="{Binding ReviewVolume}" Margin="10,0,0,0"/></DockPanel><StackPanel x:Name="PreviewMetadata"><TextBlock Text="{Binding ReviewSelected.Record.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Style="{StaticResource ClipHint}"><Run Text="{Binding ReviewSelected.Record.DurationLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReviewSelected.Record.Resolution,Mode=OneWay}"/></TextBlock><Border HorizontalAlignment="Left" CornerRadius="12" BorderBrush="#22C55E" BorderThickness="1" Padding="8,3"><TextBlock Text="{Binding ReviewSelected.Record.ScoreLabel}" Foreground="#5BDE9A" FontSize="11"/></Border><TextBlock Text="{Binding ReviewSelected.Record.Tags}" Style="{StaticResource ClipHint}"/></StackPanel></StackPanel>
     <local:AspectRatioHost x:Name="ReviewAspectHost" Ratio="{Binding SourceAspect}" Margin="0,0,0,8"><ContentControl x:Name="PreviewHost" MinHeight="0" Background="Black" ClipToBounds="True"/></local:AspectRatioHost>
    </DockPanel></TabItem><TabItem x:Name="CompactDetailsTab" Header="Details / Export" Visibility="Collapsed"><ContentControl x:Name="CompactDetailsHost"/></TabItem></TabControl></Border>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
    <Border Grid.Column="2" Style="{StaticResource ClipPanel}" Padding="9"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><DockPanel><Button Content="Select all" Click="OnSelectAll" Style="{StaticResource ClipAction}" DockPanel.Dock="Right" Padding="5"/><TextBlock Text="Generated Clips" Style="{StaticResource ClipHeading}"/></DockPanel><WrapPanel Margin="0,0,0,8"><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewSorts}" SelectedItem="{Binding ReviewSort}" Width="102" FontSize="10" Margin="0,0,5,0"/><Button Content="Shortest" Command="{Binding SortReviewCommand}" CommandParameter="Shortest" Style="{StaticResource ClipAction}" Padding="6"/><Button Content="Longest" Command="{Binding SortReviewCommand}" CommandParameter="Longest" Style="{StaticResource ClipAction}" Padding="6"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewTags}" SelectedItem="{Binding ReviewTag}" Width="100" FontSize="10"/></WrapPanel></StackPanel>
     <ListBox x:Name="ClipsList" ItemsSource="{Binding ReviewView}" SelectedItem="{Binding ReviewSelected}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,0,0,6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#15212D"/><Setter Property="BorderBrush" Value="#293E4E"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="#102F3E"/><Setter Property="BorderBrush" Value="#00D8EF"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="59"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center"><Border Background="#1A3A4C" CornerRadius="5" Padding="3,5" Margin="0,0,5,3"><TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" Foreground="#8AE6FF" FontWeight="SemiBold"/></Border><CheckBox IsChecked="{Binding Marked}" IsEnabled="{Binding Record.Ready}" ToolTip="Select for batch export" Margin="0,2,0,0"/></StackPanel>
 <Grid Grid.Column="1" Margin="0,0,8,0" Height="72"><Border Background="#091722" CornerRadius="5" ClipToBounds="True"><Image Source="{Binding Thumbnail,Converter={StaticResource ClipThumbnail},IsAsync=True}" Stretch="UniformToFill"/></Border><Border Background="#D9000710" Padding="4,2" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"><TextBlock Text="{Binding Record.DurationLabel}" FontSize="9" Foreground="White"/></Border></Grid>
 <StackPanel Grid.Column="2" Margin="3,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Record.Title}" Foreground="#F5F8FC" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Title}"/><TextBlock Text="{Binding Record.Explanation}" MaxHeight="28" TextWrapping="Wrap" FontSize="9" Foreground="#97BBD2" Margin="0,5,0,5"/><ItemsControl ItemsSource="{Binding TagItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ClipBadge}" Padding="4,2" Margin="0,0,3,2"><TextBlock Text="{Binding}" Style="{StaticResource ClipTagText}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
 <StackPanel Grid.Column="3" Margin="0,2,6,0"><Border CornerRadius="10" BorderBrush="#299D6D" BorderThickness="1" Padding="4,3"><TextBlock Text="{Binding Record.ScoreLabel}" Foreground="#61DDA0" FontSize="9" TextAlignment="Center"/></Border><TextBlock Text="AI clip score" Foreground="#91B3C9" FontSize="8" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
 <StackPanel Grid.Column="4" VerticalAlignment="Center"><DockPanel><Button DockPanel.Dock="Right" Click="OnMoreActions" Style="{StaticResource ClipAction}" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="More actions"><local:LucideIcon Kind="ellipsis-vertical" Width="12" Height="12" Stroke="#A2C5DD"/></Button><Button Command="{Binding DataContext.PreviewReviewCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource ClipPrimary}" Padding="8,4"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="play" Width="12" Height="12" Stroke="#02212B" Margin="0,0,5,0"/><TextBlock Text="Preview" FontSize="10"/></StackPanel></Button></DockPanel><UniformGrid Columns="3"><Button Content="Edit" Command="{Binding DataContext.EditReviewCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding Record.Ready}" Style="{StaticResource ClipAction}" Padding="3,4" FontSize="8" MinHeight="24"/><Button Content="Duplicate" ToolTip="Duplicate as an independent editable timeline" Command="{Binding DataContext.DuplicateReviewCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding Record.Ready}" Style="{StaticResource ClipAction}" Padding="3,4" FontSize="8" MinHeight="24"/><Button Content="Export" Command="{Binding DataContext.ExportReviewOneCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding Record.Ready}" Style="{StaticResource ClipAction}" Padding="3,4" FontSize="8" MinHeight="24"/></UniformGrid></StackPanel>
 </Grid><TextBlock Text="{Binding Record.Status}" FontSize="9" Foreground="#F3BD77"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Record.Ready}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ExportState}" FontSize="9" Foreground="#9FBBD0" TextWrapping="Wrap"/><ProgressBar Value="{Binding ExportProgress}" Height="3" Margin="0,3,0,0"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource ClipProgress}"><Style.Triggers><DataTrigger Binding="{Binding ExportProgress}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel></Border>
    <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>
    <Border x:Name="DetailsBorder" Grid.Column="4" Style="{StaticResource ClipPanel}" Padding="12"><ContentControl x:Name="WideDetailsHost"><local:ReviewDetails x:Name="DetailsView"/></ContentControl></Border>
   </Grid>
  </DockPanel>
 </Grid>
</UserControl>