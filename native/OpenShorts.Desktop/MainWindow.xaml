<Window x:Class="OpenShorts.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:local="clr-namespace:OpenShorts.Desktop" Title="OpenShorts Studio" Width="1600" Height="1000" MinWidth="1120" MinHeight="760" Background="{StaticResource Base}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" WindowStyle="None" WindowStartupLocation="Manual" AllowDrop="True" Drop="OnDrop" Validation.Error="OnValidationError" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
 <local:RouteMatchConverter x:Key="RouteMatches"/>
 <Style x:Key="StudioNavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,5"/><Setter Property="Margin" Value="5,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Hover" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="#102D3B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="BorderBrush" Value="#00CFE8"/><Setter TargetName="Hover" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <DataTemplate x:Key="StudioNavTemplate"><Button x:Name="NavButton" Style="{StaticResource StudioNavButton}" Command="{Binding DataContext.NavigateHomeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding}"><StackPanel Width="64"><Border x:Name="Tile" Width="40" Height="40" CornerRadius="9" Background="#0F202D" HorizontalAlignment="Center"><local:LucideIcon x:Name="NavIcon" Kind="{Binding}" Width="22" Height="22" Stroke="#BECDD9"/></Border><TextBlock x:Name="NavLabel" Text="{Binding}" FontSize="9" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#AAADB8"/></StackPanel></Button><DataTemplate.Triggers><DataTrigger Binding="{Binding}" Value="Settings"><Setter TargetName="Tile" Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Account"><Setter TargetName="Tile" Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource RouteMatches}"><Binding/><Binding Path="DataContext.Route" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter TargetName="NavButton" Property="Background" Value="#082733"/><Setter TargetName="Tile" Property="Background" Value="#00CFE8"/><Setter TargetName="NavIcon" Property="Stroke" Value="White"/><Setter TargetName="NavLabel" Property="Foreground" Value="#00D9EC"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="2" Background="#141416" Padding="16,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 2,0 Q 0,0 0,3 L 0,27 Q 0,30 3,28 L 26,16 Q 29,14 26,12 Z M 7,8 L 7,21 19,14 Z" Fill="{StaticResource Accent}" Width="28" Height="30" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="OpenShorts Studio" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/></StackPanel>
   <Grid WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Margin="0,0,32,0" MaxWidth="720" Visibility="{Binding IsNotEditor,Converter={StaticResource Visible}}"><TextBox x:Name="HomeSearchBox" Text="{Binding HomeSearch,UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="34,7,55,7" Height="34" VerticalAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Search projects, templates and workspaces" PreviewKeyDown="OnSearchKey"/><local:LucideIcon Kind="Search" Width="16" Height="16" Stroke="#A4ACBE" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Search projects, templates, or type a command…" Foreground="#93ACBD" Margin="34,0,52,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HomeSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="Ctrl+K" Foreground="#8E94A2" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/><Popup x:Name="HomeSearchPopup" PlacementTarget="{Binding ElementName=HomeSearchBox}" Placement="Bottom" IsOpen="{Binding HomeSearchVisible,Mode=OneWay}" StaysOpen="True" AllowsTransparency="True" Focusable="False"><Border Background="#242529" BorderBrush="#454854" BorderThickness="1" Padding="8" Width="{Binding ActualWidth,ElementName=HomeSearchBox}" MaxHeight="380"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding HomeSearchResults}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenHomeSearchCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,0,0,4"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No matching projects, templates or workspaces." Visibility="{Binding HomeSearchEmpty,Converter={StaticResource Visible}}" Margin="12"/></StackPanel></ScrollViewer></Border></Popup>
   </Grid>
   <Grid WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Margin="0,0,12,0" Visibility="{Binding IsEditor,Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProjectTitle,UpdateSourceTrigger=LostFocus}" MaxLength="200" Margin="0,0,12,0" Padding="12,8" VerticalAlignment="Center" ToolTip="Rename project · saved with the timeline"/><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="↶" Command="{Binding UndoEditCommand}" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource ToolButton}"/><Button Content="↷" Command="{Binding RedoEditCommand}" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource ToolButton}"/><TextBlock Text="{Binding AutosaveStatus}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" MaxWidth="130" Margin="8,0,10,0"/><ComboBox Width="78" ItemsSource="{Binding PreviewRatios}" SelectedItem="{Binding PreviewRatio}" Margin="0" Padding="5" FontSize="11"/></WrapPanel></Grid>
   <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Visibility="{Binding IsNotEditor,Converter={StaticResource Visible}}" Command="{Binding ImportCommand}" x:Name="NewProjectButton" Style="{StaticResource Primary}" Width="118" Height="34" Padding="10,7" Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="Plus" Width="14" Height="14" Stroke="#03212A" Margin="0,0,7,0"/><TextBlock Text="New Project" FontSize="11"/></StackPanel></Button><Button Visibility="{Binding IsEditor,Converter={StaticResource Visible}}" Content="Export" Command="{Binding ExportCommand}" Style="{StaticResource Primary}" Margin="0,0,12,0"/><Button Command="{Binding NavigateHomeCommand}" CommandParameter="AI Clipper" ToolTip="Processing activity" Background="Transparent" BorderBrush="Transparent" Padding="8" Margin="0"><local:LucideIcon Kind="Bell" Width="18" Height="18" Stroke="#B2B7C5"/></Button><Button Command="{Binding NavigateHomeCommand}" CommandParameter="Account" ToolTip="Your local workspace" Background="Transparent" BorderBrush="Transparent" Padding="8" Margin="0,0,12,0"><Ellipse Width="26" Height="26"><Ellipse.Fill><ImageBrush ImageSource="/OpenShorts.Desktop;component/Assets/Studio/creator-hero.png" Viewbox=".38,.01,.24,.46" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Button><Button Click="OnMinimize" Background="Transparent" BorderBrush="Transparent" Padding="9" Margin="0" AutomationProperties.Name="Minimize"><local:LucideIcon Kind="Minimize" Width="16" Height="16" Stroke="#CFD2DA"/></Button><Button Click="OnMaximize" Background="Transparent" BorderBrush="Transparent" Padding="9" Margin="0" AutomationProperties.Name="Maximize or restore"><local:LucideIcon Kind="square" Width="15" Height="15" Stroke="#CFD2DA"/></Button><Button Click="OnClose" Background="Transparent" BorderBrush="Transparent" Padding="9" Margin="0" AutomationProperties.Name="Close"><local:LucideIcon Kind="Close" Width="17" Height="17" Stroke="#CFD2DA"/></Button></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="#111113" BorderBrush="#2B2C31" BorderThickness="0,0,1,0"><DockPanel>
 <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,7"><ItemsControl ItemsSource="{Binding BottomNav}" ItemTemplate="{StaticResource StudioNavTemplate}"/><Button Click="OnOpenQuickTour" Background="Transparent" BorderThickness="0" Padding="0,6" Margin="0" ToolTip="Quick tour"><StackPanel><local:LucideIcon Kind="Help" Width="19" Height="19" Stroke="#999DA9"/><TextBlock Text="Help" FontSize="9" Foreground="#999DA9" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding PrimaryNav}" ItemTemplate="{StaticResource StudioNavTemplate}" Margin="0,8,0,0"/></ScrollViewer>
 </DockPanel></Border>
  <Grid Grid.Column="1" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="1" Background="#38252A" Padding="16,10"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Error}" Foreground="#FFC4BD"/></Border>
   <Grid Grid.Row="2" Margin="18,6,12,10">
    <local:HomePanel x:Name="HomeDashboard" Visibility="{Binding IsHome,Converter={StaticResource Visible}}"/>
    <Grid Visibility="{Binding IsProjects,Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Your projects" Style="{StaticResource Title}"/><TextBlock Text="Durable local projects, independent of browser sessions." Style="{StaticResource Hint}"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding JobId}" FontSize="16"/><TextBlock Text="{Binding Modified,StringFormat='Saved {0:g}'}" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Clips,StringFormat='{}{0} clips'}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Refresh" Command="{Binding RefreshProjectsCommand}"/><Button Content="Open project" Command="{Binding OpenProjectCommand}" Style="{StaticResource Primary}"/></WrapPanel>
    </Grid>
    <local:ClipperWorkspaceView x:Name="ClipperWorkspace" Visibility="{Binding IsClipper,Converter={StaticResource Visible}}"/>
    <Grid x:Name="EditorWorkspace" Visibility="{Binding IsEditor,Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="*" MinHeight="245"/><RowDefinition Height="8"/><RowDefinition x:Name="TimelineRow" Height="300" MinHeight="280"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="AssetsColumn" Width="320" MinWidth="0"/><ColumnDefinition x:Name="AssetsDividerColumn" Width="8"/><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition x:Name="InspectorDividerColumn" Width="8"/><ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="0"/></Grid.ColumnDefinitions>
      <local:EditorAssetsPanel Visibility="{Binding AssetsVisible,Converter={StaticResource Visible}}"/>
      <GridSplitter DragCompleted="OnEditorLayoutDragCompleted" Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{StaticResource Line}"/>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Background="#151518" BorderBrush="#293747" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><TextBlock Text="Open a generated clip to start editing" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <local:AspectRatioHost Ratio="{Binding PreviewAspect}" Zoom="{Binding PreviewZoom}"><ContentControl x:Name="EditorPreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><vlc:VideoView x:Name="VideoView" MediaPlayer="{Binding Preview.Player}"><local:PreviewOverlayControl x:Name="PreviewOverlay"/></vlc:VideoView></ContentControl></local:AspectRatioHost>
       </Grid></Border>
       <StackPanel Grid.Row="1" Margin="4,7,4,0"><Slider x:Name="Playhead" Style="{StaticResource EditorSlider}" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding SeekSeconds}" PreviewMouseLeftButtonUp="OnSeek" Margin="0"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel VerticalAlignment="Center"><TextBlock Text="{Binding PlaybackClock}" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"/><Button Content="|◀" ToolTip="Back approximately 0.1 seconds" Command="{Binding PreviousPositionCommand}" Style="{StaticResource ToolButton}"/><Button Content="▶ / Ⅱ" ToolTip="Play or pause (Space)" Command="{Binding PlayPauseCommand}" Style="{StaticResource ToolButton}"/><Button Content="▶|" ToolTip="Request next decoded frame" Command="{Binding StepForwardCommand}" Style="{StaticResource ToolButton}"/><Button x:Name="FullscreenPreviewButton" Content="⛶" ToolTip="Fullscreen preview" Click="OnFullscreenPreview" Style="{StaticResource ToolButton}"/></WrapPanel><Slider Grid.Column="1" Width="64" Maximum="100" Value="{Binding PlaybackVolume}" ToolTip="Preview volume" Style="{StaticResource EditorSlider}"/></Grid>
        <WrapPanel Margin="0,5,0,0"><TextBox x:Name="SeekBox" Width="65" Text="{Binding SeekSeconds,UpdateSourceTrigger=PropertyChanged,StringFormat=F2}" Padding="5,3" Margin="0,0,5,0"/><Button Content="Seek" Command="{Binding SeekCommand}" Style="{StaticResource ToolButton}"/><TextBlock Text="{Binding PreviewMode}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/></WrapPanel>
       </StackPanel>
      </Grid>
      <GridSplitter DragCompleted="OnEditorLayoutDragCompleted" Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="{StaticResource Line}"/><local:EditorInspector Grid.Column="4" Visibility="{Binding InspectorVisible,Converter={StaticResource Visible}}"/>
     </Grid>
     <GridSplitter DragCompleted="OnEditorLayoutDragCompleted" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:EditorTimelinePanel MinHeight="280"/></ScrollViewer>
    </Grid>
    <local:PublishingPanel Visibility="{Binding IsPublishing,Converter={StaticResource Visible}}"/>
    <local:CreativePanel Visibility="{Binding IsCreative,Converter={StaticResource Visible}}"/>
    <local:TemplatePanel Visibility="{Binding IsTemplates,Converter={StaticResource Visible}}"/>
    <ScrollViewer Visibility="{Binding IsSettings,Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource Title}"/><TextBlock Text="Gemini API key"/><PasswordBox x:Name="GeminiPassword" PasswordChanged="OnPasswordChanged" Padding="10" Margin="0,8,0,8" Background="#1C2530" Foreground="White"/><TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Hint}"/><TextBlock Text="Additional provider keys" FontSize="20" Margin="0,20,0,12"/><TextBlock Text="Leave a field empty to keep its saved key. Keys use Windows current-user DPAPI." Style="{StaticResource Hint}"/><TextBlock Text="ElevenLabs · dubbing and voices"/><PasswordBox PasswordChanged="OnElevenLabsChanged" Style="{StaticResource SecretInput}"/><TextBlock Text="Fal · product videos"/><PasswordBox PasswordChanged="OnFalChanged" Style="{StaticResource SecretInput}"/><TextBlock Text="Upload-Post · publishing"/><PasswordBox PasswordChanged="OnUploadPostChanged" Style="{StaticResource SecretInput}"/><WrapPanel><Button Content="Save provider keys" Command="{Binding SaveProviderCredentialsCommand}"/><Button Content="Clear provider keys" Command="{Binding ClearProviderCredentialsCommand}"/></WrapPanel><TextBlock Text="FFmpeg encoder"/><ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}"/><TextBlock Text="Performance preset"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/><Button Content="Save protected settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/><Button Content="Remove saved Gemini key" Command="{Binding ClearCredentialCommand}" HorizontalAlignment="Left"/><Button Content="Detect rendering hardware" Command="{Binding DetectHardwareCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Hardware}" Style="{StaticResource Hint}"/><Button Content="Clean old thumbnail caches" Command="{Binding CleanThumbnailCacheCommand}" HorizontalAlignment="Left" ToolTip="Removes generated thumbnail and feature caches older than 24 hours; active jobs and media are kept"/><TextBlock Text="Local runtime" FontSize="18" Margin="0,16,0,8"/>
<Button Content="Refresh runtime status" Command="{Binding RefreshRuntimeCommand}"/>
<TextBlock Text="{Binding ModelAvailability}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
<WrapPanel><Button Content="Prepare / repair speech model…" Command="{Binding DownloadSpeechModelCommand}"/><Button Content="Cancel model download" Command="{Binding CancelSpeechModelCommand}"/></WrapPanel>
<TextBlock Text="{Binding OptionalRendererStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
<WrapPanel><Button Content="Start optional renderer" Command="{Binding StartOptionalRendererCommand}"/><Button Content="Restart renderer" Command="{Binding RestartOptionalRendererCommand}"/><Button Content="Stop renderer" Command="{Binding StopOptionalRendererCommand}"/></WrapPanel><TextBlock Text="Library location" FontSize="18" Margin="0,12,0,8"/><TextBlock Text="{Binding Library}" Foreground="{StaticResource Muted}"/></StackPanel></ScrollViewer>
    <StackPanel Visibility="{Binding IsAccount,Converter={StaticResource Visible}}" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="Account" Style="{StaticResource Title}"/><TextBlock Text="Local workspace" FontSize="21" Margin="0,10,0,12"/><TextBlock Text="AI analysis uses your Gemini credentials from Settings. This build has no connected subscription service. Paid licenses, trials and device activation require a trusted account provider; no paid access is granted locally." Style="{StaticResource Hint}" FontSize="15"/></StackPanel>
   </Grid>

  </Grid>
 </Grid>
</Window>
