<UserControl x:Class="OpenShorts.Desktop.GenerationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#EDF5FC" xmlns:local="clr-namespace:OpenShorts.Desktop">

 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource ClipInput}"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,5,8,10"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource ClipCombo}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,5,8,10"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ClipToggle}"><Setter Property="Margin" Value="0,8,12,10"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource ClipAction}"/>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#DCEAF7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Border Background="#101B27" BorderBrush="#263D50" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><ContentPresenter ContentSource="Header" Margin="0,0,0,14"/><ContentPresenter/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><Grid Width="980" Height="650"><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="105"/></Grid.RowDefinitions>
  <Border Style="{StaticResource ClipPanel}" Margin="0,0,0,12" Padding="20,16"><StackPanel><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="scissors" Stroke="#00D8EF" Width="25" Height="25" Margin="0,0,10,0"/><TextBlock Text="Clip Generation Settings" FontSize="24" FontWeight="Bold"/></StackPanel><TextBlock Text="Configure your clips before starting AI analysis." Style="{StaticResource ClipHint}"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Change video" Command="{Binding ImportCommand}"/><StackPanel><TextBlock Text="{Binding ImportedFile}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding ImportedMediaDescription}" Style="{StaticResource ClipHint}"/></StackPanel></DockPanel></StackPanel></Border>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"><TabItem Header="Clip Settings"><GroupBox Header="Story &amp; Format"><StackPanel IsEnabled="{Binding CanImport}">
   <UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Create"/><ComboBox ItemsSource="{Binding GenerationModes}" SelectedItem="{Binding GenerationMode}"/><TextBlock Text="Analysis"/><ComboBox ItemsSource="{Binding AnalysisModes}" SelectedItem="{Binding AnalysisMode}"/><CheckBox Content="Automatic clip count" IsChecked="{Binding AutomaticClipCount}"/><TextBlock Text="Clip count (1–12)"/><TextBox Text="{Binding TargetClipCount,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel><TextBlock Text="Aspect ratio"/><ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}"/><CheckBox Content="Automatic story duration" IsChecked="{Binding AutomaticClipDuration}"/><TextBlock Text="Target clip length (10–150 s)"/><TextBox Text="{Binding TargetClipSeconds,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Summary length (30–180 s)"/><TextBox Text="{Binding SummarySeconds,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid>
</StackPanel></GroupBox></TabItem><TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><GroupBox Header="Framing, Quality &amp; Pacing"><StackPanel IsEnabled="{Binding CanImport}">   <UniformGrid Columns="2"><StackPanel><TextBlock Text="Minimum duration (blank = default)"/><TextBox Text="{Binding MinimumClipSeconds,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel><TextBlock Text="Maximum duration (blank = default)"/><TextBox Text="{Binding MaximumClipSeconds,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid><UniformGrid Columns="3"><StackPanel><TextBlock Text="Framing"/><ComboBox ItemsSource="{Binding FramingPresets}" SelectedItem="{Binding GenerationFraming}"/></StackPanel><StackPanel><TextBlock Text="Quality"/><ComboBox ItemsSource="{Binding QualityModes}" SelectedItem="{Binding GenerationQuality}"/></StackPanel><StackPanel><TextBlock Text="Pacing"/><ComboBox ItemsSource="{Binding PacingModes}" SelectedItem="{Binding GenerationPacing}"/></StackPanel></UniformGrid><TextBlock Text="Adaptive analysis category (adaptive modes only)"/><ComboBox ItemsSource="{Binding AnalysisCategories}" SelectedItem="{Binding AnalysisCategory}"/><TextBlock Text="Optional highlight instruction"/><TextBox MaxLength="500" Text="{Binding AnalysisPrompt}" ToolTip="Source-grounded topic preference; adaptive modes only"/><CheckBox Content="Trim silence at edit boundaries" IsChecked="{Binding TrimSilence}"/><CheckBox Content="Create a source-backed hook" IsChecked="{Binding AutoHook}"/>
</StackPanel></GroupBox></ScrollViewer></TabItem><TabItem Header="Captions &amp; Design">  <GroupBox Header="03   CAPTIONS &amp; DESIGN"><StackPanel IsEnabled="{Binding CanImport}"><CheckBox Content="Source already has burned-in captions" IsChecked="{Binding SourceHasCaptions}"/><CheckBox Content="Generate captions" IsChecked="{Binding GenerateCaptions}"/><ComboBox ItemsSource="{Binding GenerationCaptionPresets}" SelectedItem="{Binding GenerationCaptionPreset}"/><TextBlock Text="Video template"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"/><Button Content="Clear template" Command="{Binding ClearTemplateCommand}"/></StackPanel></GroupBox>
</TabItem><TabItem Header="Audio Mastering">  <GroupBox Header="04   AUDIO MASTERING"><StackPanel IsEnabled="{Binding CanImport}"><ComboBox ItemsSource="{Binding AudioPresets}" SelectedItem="{Binding GenerationAudio}"/><UniformGrid Columns="3"><StackPanel Margin="0,0,8,0"><TextBlock Text="Target LUFS"/><TextBox Text="{Binding AudioLufs,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Peak dBTP"/><TextBox Text="{Binding AudioPeak,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel><TextBlock Text="Fade (s)"/><TextBox Text="{Binding AudioFade,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid><CheckBox Content="Reduce background noise" IsChecked="{Binding AudioNoise}"/></StackPanel></GroupBox>
</TabItem></TabControl>
  <Border Grid.Row="2" Style="{StaticResource ClipPanel}" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Generate clips →" Command="{Binding StartClippingCommand}" Style="{StaticResource ClipPrimary}" Padding="20,10"/><StackPanel><CheckBox Content="I have permission to process this footage" IsChecked="{Binding Acknowledged}"/><TextBlock Text="Starting generation sends this source to your configured AI provider." Style="{StaticResource ClipHint}"/></StackPanel></DockPanel></Border>
 </Grid></Viewbox>
</UserControl>
