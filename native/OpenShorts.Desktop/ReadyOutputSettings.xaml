<UserControl x:Class="OpenShorts.Desktop.ReadyOutputSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Export Format" Style="{StaticResource ReadyHeading}"/><UniformGrid Columns="3"><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=vertical,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Portrait" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="YouTube / TikTok / Reels" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=square,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Square" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Square" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=horizontal,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Landscape" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Landscape" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid><TextBlock Text="{Binding OutputDescription}" Style="{StaticResource ReadyHint}"/><TextBlock Text="Quality preset"/><ComboBox ItemsSource="{Binding QualityModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Quality}" Margin="0,4,0,12"/><TextBlock Text="{Binding EncoderInfo}" Style="{StaticResource ReadyHint}"/><TextBlock Text="Encoder follows your app Settings. Custom resolution, codec and frame rate controls are not available here." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Captions" Style="{StaticResource ReadyHeading}"/><CheckBox Content="Include captions" IsChecked="{Binding Captions}" Margin="0,4,0,9"/><TextBlock Text="Caption preset"/><ComboBox ItemsSource="{Binding CaptionPresets}" SelectedItem="{Binding CaptionPreset}" Margin="0,4,0,12"/><Border Background="#10151C" CornerRadius="8" Padding="14" Margin="0,2,0,10"><StackPanel><TextBlock Text="{Binding CaptionSample}" FontFamily="{Binding CaptionFont}" FontSize="{Binding CaptionSize}" Foreground="{Binding CaptionColor}" HorizontalAlignment="Center"/><TextBlock Text="{Binding CaptionEffect}" Style="{StaticResource ReadyHint}"/></StackPanel></Border><CheckBox Content="Source already has burned-in captions · skip an extra layer" IsChecked="{Binding ExistingCaptions}" Margin="0,4,0,9"/><TextBlock Text="Word highlighting, animation and position follow the selected engine preset. Per-word appearance controls are available in Video Editor." Style="{StaticResource ReadyHint}"/><TextBlock Text="Video template"/><ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding TemplateId}"/><Button Content="Use automatic framing &amp; template" Command="{Binding AutoVisualsCommand}" HorizontalAlignment="Left"/><Button Content="Clear template" Command="{Binding ClearTemplateCommand}" HorizontalAlignment="Left"/><TextBlock Text="Automatic chooses a template from the analyzed story. Choose any template manually to override it; your framing choice remains in control." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Framing" Style="{StaticResource ReadyHeading}"/><TextBlock Text="Subject and scene framing"/><ComboBox ItemsSource="{Binding FramingPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Framing}" Margin="0,4,0,12"/><TextBlock Text="auto = scene aware · subject = dominant subject · balanced = preserve groups · editorial = detail and context." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Audio Mastering" Style="{StaticResource ReadyHeading}"/><TextBlock Text="Preset · natural / clear dialogue / original"/><ComboBox ItemsSource="{Binding AudioPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AudioPreset}" Margin="0,4,0,12"/><UniformGrid Columns="3" IsEnabled="{Binding CanCustomizeAudio}"><StackPanel Margin="0,0,9,0"><TextBlock Text="LUFS (−24 to −12)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding AudioTarget,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="0,0,9,0"><TextBlock Text="Peak (−6 to −1 dBTP)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding AudioPeak,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel><TextBlock Text="Fade (0–2 s)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding AudioFade,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid><CheckBox IsEnabled="{Binding CanCustomizeAudio}" Content="Light noise reduction" IsChecked="{Binding AudioNoise}" Margin="0,4,0,9"/><TextBlock Text="Original keeps original mastering. Custom values use the existing audio normalizer and mastering pipeline." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Output Location" Style="{StaticResource ReadyHeading}"/><TextBlock Text="{Binding OutputLocation}" TextWrapping="Wrap"/><TextBlock Text="Clips save to your current library’s output folder." Style="{StaticResource ReadyHint}"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>