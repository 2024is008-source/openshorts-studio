<UserControl x:Class="OpenShorts.Desktop.DesktopStatusPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" Foreground="{StaticResource Ink}" FontFamily="Segoe UI Variable Display, Segoe UI">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BrandResources.xaml"/></ResourceDictionary.MergedDictionaries>

 <Style x:Key="StatusCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#34353C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="SideButton" TargetType="Button"><Setter Property="Foreground" Value="#F4F4F7"/><Setter Property="FontSize" Value="9"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#122737"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#34353C" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#19394D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#00CFE8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="CardHeading" TargetType="Button" BasedOn="{StaticResource SideButton}"><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Head" Background="{TemplateBinding Background}" BorderBrush="#34353C" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Head" Property="Background" Value="#292C33"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource CardHeading}"><Setter Property="Padding" Value="10,5"/></Style>
 <Style x:Key="ModePicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="9"/><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#232429" BorderBrush="#34353C" BorderThickness="1" CornerRadius="6"/></ControlTemplate></ToggleButton.Template></ToggleButton><local:StudioIcon Kind="Brain" Stroke="#00D7EF" Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="29,0,22,0" IsHitTestVisible="False"/><local:StudioIcon Kind="Chevron" Stroke="#A4A5AF" Width="10" Height="10" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False"><local:StudioIcon.RenderTransform><RotateTransform Angle="90" CenterX="5" CenterY="5"/></local:StudioIcon.RenderTransform></local:StudioIcon><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#232429" BorderBrush="#34353C" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ItemsPresenter/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></UserControl.Resources>
<ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="SidebarLayout" Height="{Binding ActualHeight,ElementName=SidebarScroll}" MinHeight="602"><Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="147"/><RowDefinition Height="*" MinHeight="197"/><RowDefinition Height="58"/></Grid.RowDefinitions>
 <Border x:Name="SystemCard" Grid.Row="0" Style="{StaticResource StatusCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="56"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Button Style="{StaticResource CardHeading}" Command="{Binding NavigateHomeCommand}" CommandParameter="Settings"><DockPanel><local:StudioIcon Kind="Chevron" DockPanel.Dock="Right" Width="11" Height="14" Stroke="#A4A5AF"/><TextBlock Text="System &amp; Performance" FontSize="10" FontWeight="SemiBold"/></DockPanel></Button>
  <Grid Grid.Row="1" Margin="10,9,10,8" ToolTip="{Binding HomeRenderStatus}"><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#273B2D" Width="30" Height="31" CornerRadius="5"><Grid><Path Data="{StaticResource NvidiaBrandGeometry}" Fill="#79C900" Width="23" Height="20" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HomeGpuEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><local:StudioIcon Kind="Gpu" Width="22" Height="22" Stroke="#A4A5AF"><local:StudioIcon.Style><Style TargetType="local:StudioIcon"><Style.Triggers><DataTrigger Binding="{Binding HomeGpuEnabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:StudioIcon.Style></local:StudioIcon></Grid></Border><Grid Grid.Column="1" Margin="8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding HomeGpuDetail}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding HomeGpuDetail}"/><Border Grid.Column="1" Background="#06482E" CornerRadius="5" Padding="5,2" Margin="4,0,0,0" VerticalAlignment="Center"><TextBlock Foreground="#00E58B" FontSize="8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="CPU"/><Style.Triggers><DataTrigger Binding="{Binding HomeGpuEnabled}" Value="True"><Setter Property="Text" Value="Enabled"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding HomeGpuFeatures}" Foreground="#A4A5AF" FontSize="8.5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid></Grid>
  <Border Grid.Row="2" BorderBrush="#34353C" BorderThickness="0,1,0,1" Margin="10,0" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Processing Mode" FontSize="9" Foreground="#A4A5AF" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource ModePicker}" ItemsSource="{Binding HomeProcessingModes}" SelectedItem="{Binding HomeProcessingMode}" Foreground="#DFEAF3"/></Grid></Border>
  <Grid Grid.Row="3" Margin="10,8,10,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Estimated Speed" FontSize="9" Foreground="#A4A5AF" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><Viewbox Width="25" Height="17" Margin="0,0,6,0"><Canvas Width="30" Height="20"><Path Data="M3,18 A12,12 0 0 1 9,5" Stroke="#00BEB1" StrokeThickness="4" StrokeStartLineCap="Round"/><Path Data="M9,5 A12,12 0 0 1 22,6" Stroke="#E2CD31" StrokeThickness="4"/><Path Data="M22,6 A12,12 0 0 1 27,18" Stroke="#F38C31" StrokeThickness="4" StrokeEndLineCap="Round"/><Path Data="M15,17 L23,7" Stroke="#00D9D4" StrokeThickness="2" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Not measured" FontSize="9" Foreground="#A4A5AF" VerticalAlignment="Center" ToolTip="No verified processing benchmark is available."/></StackPanel></StackPanel><Button Grid.Column="1" Content="Run Benchmark" Style="{StaticResource SideButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Processing benchmarks are not available in this build." VerticalAlignment="Bottom" Padding="5,6"/></Grid>
 </Grid></Border>
 <Border x:Name="StorageCard" Grid.Row="1" Style="{StaticResource StatusCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Style="{StaticResource CardHeading}" Command="{Binding OpenLibraryFolderCommand}"><DockPanel><local:StudioIcon Kind="Chevron" DockPanel.Dock="Right" Width="11" Height="14" Stroke="#A4A5AF"/><TextBlock Text="Storage" FontSize="10" FontWeight="SemiBold"/></DockPanel></Button><StackPanel Grid.Row="1" Margin="10,7,10,8"><DockPanel Margin="0,0,0,7"><local:StudioIcon Kind="Disk" DockPanel.Dock="Left" Width="21" Height="19" Stroke="#A4A5AF" Margin="3,0,10,0"/><TextBlock Text="{Binding HomeStoragePath}" ToolTip="{Binding HomeStoragePath}" FontSize="9" Foreground="#B8BBC5" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel><ProgressBar Value="{Binding HomeStorageBar}" Maximum="1" Height="7" Background="#34363D" Foreground="#6BAF8A"/><Grid Margin="0,5,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="#A4A5AF" FontSize="8.5"><Run Text="{Binding HomeStorageUsed}"/><Run Text=" of "/><Run Text="{Binding HomeStorageTotal}"/></TextBlock><TextBlock Grid.Column="1" Text="{Binding HomeStorageFree}" Foreground="#A4A5AF" FontSize="8.5"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Command="{Binding OpenLibraryFolderCommand}" Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Folder" Width="12" Height="12" Stroke="#B8BBC5" Margin="0,0,5,0"/><TextBlock Text="Open Folder"/></StackPanel></Button><Button Grid.Column="2" Command="{Binding NavigateHomeCommand}" CommandParameter="Projects" Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Projects" Width="12" Height="12" Stroke="#B8BBC5" Margin="0,0,5,0"/><TextBlock Text="Manage Files"/></StackPanel></Button></Grid></StackPanel></Grid></Border>
 <Border x:Name="ExportPresetsCard" Grid.Row="2" Style="{StaticResource StatusCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Style="{StaticResource CardHeading}" Command="{Binding NavigateHomeCommand}" CommandParameter="AI Clipper"><DockPanel><local:StudioIcon Kind="Chevron" DockPanel.Dock="Right" Width="11" Height="14" Stroke="#A4A5AF"/><TextBlock Text="Export Presets" FontSize="10" FontWeight="SemiBold"/></DockPanel></Button><UniformGrid Grid.Row="1" Rows="4" Margin="0,0,0,3"><Button Style="{StaticResource PresetButton}" Command="{Binding SelectHomePresetCommand}" CommandParameter="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="5" Background="#292B32"><Grid Width="19" Height="21"><Path Data="{StaticResource TiktokBrandGeometry}" Fill="#00E4E8" Stretch="Uniform" Margin="-1,-1,1,1"/><Path Data="{StaticResource TiktokBrandGeometry}" Fill="#FF385A" Stretch="Uniform" Margin="1,1,-1,-1"/><Path Data="{StaticResource TiktokBrandGeometry}" Fill="White" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="TikTok Shorts" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="1080 × 1920 · MP4" FontSize="9" Foreground="#A4A5AF" Margin="0,2,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="11" Height="13" Stroke="#A4A5AF"/></Grid></Button><Button Style="{StaticResource PresetButton}" Command="{Binding SelectHomePresetCommand}" CommandParameter="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="5" Background="#292B32"><Grid Width="22" Height="18"><Path Fill="White" Data="M7,5 L17,5 17,19 7,19Z" Stretch="Uniform" Margin="7,4"/><Path Data="{StaticResource YoutubeBrandGeometry}" Fill="#FF0033" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="YouTube Shorts" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="1080 × 1920 · MP4" FontSize="9" Foreground="#A4A5AF" Margin="0,2,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="11" Height="13" Stroke="#A4A5AF"/></Grid></Button><Button Style="{StaticResource PresetButton}" Command="{Binding SelectHomePresetCommand}" CommandParameter="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="5" Background="#292B32"><Border Width="23" Height="23" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FFD56A"/><GradientStop Color="#F34761" Offset=".45"/><GradientStop Color="#A73CD7" Offset=".75"/><GradientStop Color="#674AE2" Offset="1"/></LinearGradientBrush></Border.Background><Path Data="{StaticResource InstagramBrandGeometry}" Fill="White" Width="17" Height="17" Stretch="Uniform"/></Border></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Instagram Reels" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="1080 × 1920 · MP4" FontSize="9" Foreground="#A4A5AF" Margin="0,2,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="11" Height="13" Stroke="#A4A5AF"/></Grid></Button><Button Style="{StaticResource PresetButton}" Command="{Binding SelectHomePresetCommand}" CommandParameter="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="5" Background="#29364B"><local:StudioIcon Kind="Settings" Width="21" Height="21" Stroke="#00D7EF"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Custom Preset" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Set your own export settings" FontSize="9" Foreground="#A4A5AF" Margin="0,2,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="11" Height="13" Stroke="#A4A5AF"/></Grid></Button></UniformGrid></Grid></Border>
 <Border x:Name="AccountCard" Grid.Row="3" Style="{StaticResource StatusCard}" Margin="0"><Button Style="{StaticResource CardHeading}" Command="{Binding NavigateHomeCommand}" CommandParameter="Account" Padding="10,7" ToolTip="Open your account settings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Ellipse Width="34" Height="34"><Ellipse.Fill><ImageBrush ImageSource="/OpenShorts.Desktop;component/Assets/Studio/creator-hero.png" Viewbox=".38,.01,.24,.46" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Account" FontSize="10" Foreground="#F4F4F7" Margin="0,0,0,4"/><Border BorderBrush="#00647E" BorderThickness="1" Background="#003047" CornerRadius="6" Padding="5,2" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Account" Width="10" Height="10" Stroke="#00D7EF" Margin="0,0,4,0"/><TextBlock Text="Local Plan" Foreground="#00D7EF" FontSize="8"/></StackPanel></Border></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="11" Height="14" Stroke="#A4A5AF"/></Grid></Button></Border>
</Grid></ScrollViewer></UserControl>
