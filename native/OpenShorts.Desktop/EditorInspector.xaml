<UserControl x:Class="OpenShorts.Desktop.EditorInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop">
 <Border Style="{StaticResource EditorPanel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="SemiBold" Margin="0,0,0,12"/><TabControl Style="{StaticResource EditorTabs}" SelectedIndex="{Binding InspectorTab}">
  <TabItem Header="Text"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}" Margin="0,10,6,0">
   <TextBlock Text="Text &amp; Captions" Style="{StaticResource EditorHeading}"/><TextBox Text="{Binding SelectedCaption.Text,UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" ToolTip="Select a caption on the timeline or transcript"/>
   <UniformGrid Columns="2"><StackPanel><TextBlock Text="In · source seconds" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding SelectedCaption.Start,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Out · source seconds" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding SelectedCaption.End,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid>
   <CheckBox Content="Render captions" IsChecked="{Binding CaptionsEnabled}"/><TextBlock Text="Caption preset" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding CaptionPresets}" SelectedItem="{Binding CaptionPreset}"/>
   <CheckBox Content="Custom caption appearance" IsChecked="{Binding CustomCaptionStyle}"/><StackPanel IsEnabled="{Binding CustomCaptionStyle}"><TextBlock Text="Font family" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding CaptionFonts}" SelectedItem="{Binding CaptionFont}"/><CheckBox Content="Uppercase" IsChecked="{Binding CaptionUppercase}"/>
   <UniformGrid Columns="2"><StackPanel><TextBlock Text="Text color" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionColor,UpdateSourceTrigger=LostFocus}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Highlight color" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding HighlightColor,UpdateSourceTrigger=LostFocus}"/></StackPanel></UniformGrid>
   <TextBlock Text="Text position" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding CaptionPositions}" SelectedItem="{Binding CaptionPosition}"/>
   <UniformGrid Columns="2"><StackPanel><TextBlock Text="Size at 1080p" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionSize,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Line spacing" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionLineSpacing,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid>
   <TextBlock Text="Outline color / width" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding OutlineColor}"/><Slider Minimum="0" Maximum="20" Value="{Binding OutlineWidth}" Style="{StaticResource EditorSlider}"/><TextBlock Text="Shadow" Style="{StaticResource EditorLabel}"/><Slider Minimum="0" Maximum="8" Value="{Binding CaptionShadow}" Style="{StaticResource EditorSlider}"/>
   <TextBlock Text="Background color / opacity" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionBackground}"/><Slider Value="{Binding CaptionBackgroundOpacity}" Style="{StaticResource EditorSlider}"/>
   <Expander Header="Phrase layout &amp; timing"><StackPanel><TextBlock Text="Maximum lines (1–3)" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionMaxLines,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Words per phrase (1–12)" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionMaxWords,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Caption offset (−1 to 1 s)" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionSyncOffset,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Minimum phrase duration" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding CaptionMinPhrase,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Inactive word opacity" Style="{StaticResource EditorLabel}"/><Slider Minimum=".05" Maximum="1" Value="{Binding CaptionBaseOpacity}" Style="{StaticResource EditorSlider}"/></StackPanel></Expander></StackPanel>
   <Expander Header="Aligned words / emphasis" Margin="0,10"><StackPanel><TextBlock Text="Available for original aligned phrases. Rewriting a phrase disables word timing." Style="{StaticResource Hint}"/><DataGrid ItemsSource="{Binding SelectedCaption.Words}" IsEnabled="{Binding SelectedCaption.WordEditingSupported}" MaxHeight="230" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Word" Binding="{Binding Word}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="In" Binding="{Binding Start,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="55"/><DataGridTextColumn Header="Out" Binding="{Binding End,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="55"/><DataGridCheckBoxColumn Header="★" Binding="{Binding Emphasis}" Width="30"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
   <TextBlock Text="Templates use their own caption design. Render preview to verify appearance." Style="{StaticResource Hint}"/><Button Content="Render preview" Command="{Binding RenderPreviewCommand}" Style="{StaticResource Primary}"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Video"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,6,0"><TextBlock Text="Framing" Style="{StaticResource EditorHeading}"/><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="Crop mode" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding CropModes}" SelectedItem="{Binding CropMode}"/><TextBlock Text="Horizontal focal point" Style="{StaticResource EditorLabel}"/><Slider Value="{Binding CropX}" Style="{StaticResource EditorSlider}"/><TextBlock Text="Vertical focal point" Style="{StaticResource EditorLabel}"/><Slider Value="{Binding CropY}" Style="{StaticResource EditorSlider}"/></StackPanel><CheckBox Content="Show crop guides" IsChecked="{Binding CropGuides}"/><CheckBox Content="Show safe zone" IsChecked="{Binding SafeZones}"/><TextBlock Text="Preview aspect ratio" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding PreviewRatios}" SelectedItem="{Binding PreviewRatio}"/><TextBlock Text="Monitor size · display only" Style="{StaticResource EditorLabel}"/><Slider Minimum=".5" Maximum="1" Value="{Binding PreviewZoom}" Style="{StaticResource EditorSlider}"/><TextBlock Text="Aspect and zoom here change the monitor. Export controls determine output size. Rotation and freeform transform tracks are not supported." Style="{StaticResource Hint}"/><Button Content="Preview delivered clip" Command="{Binding PreviewDeliveryCommand}"/><Button Content="Return to source timeline" Command="{Binding ReturnToTimelineCommand}"/><Button Content="Render preview" Command="{Binding RenderPreviewCommand}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Audio"><ScrollViewer VerticalScrollBarVisibility="Auto"><local:EditorAudioPanel/></ScrollViewer></TabItem>
  <TabItem Header="AI Edit"><local:AutoEditPanel/></TabItem>
  <TabItem Header="Effects"><local:ClipToolsPanel/></TabItem>
  <TabItem Header="Animate"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,6,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="Caption animation" Style="{StaticResource EditorHeading}"/><CheckBox Content="Custom caption appearance" IsChecked="{Binding CustomCaptionStyle}"/><ComboBox ItemsSource="{Binding CaptionAnimations}" SelectedItem="{Binding CaptionAnimation}" IsEnabled="{Binding CustomCaptionStyle}"/><TextBlock Text="Animation timing is defined by the caption renderer. A custom duration and motion tracking are unavailable." Style="{StaticResource Hint}"/><CheckBox Content="Autosave → render preview" IsChecked="{Binding AutoPreview}"/><CheckBox Content="Approximate draft text overlay" IsChecked="{Binding DraftOverlay}"/><TextBlock Text="Draft overlays are editing guides. Render preview uses the same caption pipeline as final export." Style="{StaticResource Hint}"/><Button Content="Render preview" Command="{Binding RenderPreviewCommand}" Style="{StaticResource Primary}"/><TextBlock Text="Save a custom template" Style="{StaticResource EditorHeading}"/><TextBox Text="{Binding TemplateName}"/><ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"/><Button Content="Save as project style" Command="{Binding SaveCustomTemplateCommand}"/></StackPanel></ScrollViewer></TabItem>
 </TabControl></DockPanel></Border>
</UserControl>
