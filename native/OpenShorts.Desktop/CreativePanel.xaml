<UserControl x:Class="OpenShorts.Desktop.CreativePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
 <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Creative studio" Style="{StaticResource Title}"/><TextBlock Text="Design thumbnails, build a product video, or dub your selected clip." Style="{StaticResource Hint}"/><CheckBox Content="Enable paid provider actions for this session" IsChecked="{Binding ProviderActionsAuthorized}"/><TextBlock Text="{Binding CreativeStatus}" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/></StackPanel>
 <TabControl>
  <TabItem Header="THUMBNAILS"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Video source"/><TextBox Text="{Binding ThumbnailSource}" IsReadOnly="True"/><Button Content="Choose video…" Command="{Binding BrowseThumbnailSourceCommand}"/><Button Content="Analyze &amp; suggest titles" Command="{Binding AnalyzeThumbnailCommand}"/><ComboBox ItemsSource="{Binding ThumbnailTitles}" SelectedItem="{Binding ThumbnailTitle}"/><TextBlock Text="Title / headline"/><TextBox Text="{Binding ThumbnailTitle}" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Refine suggested titles"/><TextBox Text="{Binding TitleRefinement}"/><Button Content="Refine titles" Command="{Binding RefineThumbnailTitlesCommand}"/><TextBlock Text="Art direction"/><TextBox Text="{Binding ThumbnailPrompt}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"/><WrapPanel><Button Content="Face reference…" Command="{Binding ChooseThumbnailFaceCommand}"/><Button Content="Background…" Command="{Binding ChooseThumbnailBackgroundCommand}"/><Button Content="Clear references" Command="{Binding ClearThumbnailReferencesCommand}"/></WrapPanel><TextBlock Text="{Binding ThumbnailFace}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding ThumbnailBackground}" Style="{StaticResource Hint}"/><TextBlock Text="Variations (1–6)"/><TextBox Text="{Binding ThumbnailCount,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><Button Content="Generate thumbnails" Command="{Binding GenerateThumbnailsCommand}" Style="{StaticResource Primary}"/><Button Content="Save selected image…" Command="{Binding SaveThumbnailCommand}"/></StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><Grid><Image Source="{Binding SelectedThumbnail}" Stretch="Uniform"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedThumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Your next cover starts here" FontSize="25" TextAlignment="Center"/><TextBlock Text="Choose a video for suggested titles, or write your own title to create a cover." MaxWidth="400" TextAlignment="Center" Style="{StaticResource Hint}"/></StackPanel></Grid></Border><ListBox Grid.Row="1" ItemsSource="{Binding ThumbnailImages}" SelectedItem="{Binding SelectedThumbnail}" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="150" Height="90" Stretch="Uniform"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
  </Grid></TabItem>
  <TabItem Header="PRODUCT VIDEO / UGC"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Product website"/><TextBox Text="{Binding ProductUrl}"/><TextBlock Text="Product description"/><TextBox Text="{Binding ProductDescription}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap"/><Button Content="Research &amp; write scripts" Command="{Binding AnalyzeProductCommand}"/><TextBlock Text="Script"/><ComboBox ItemsSource="{Binding UgcScripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Name"/><TextBlock Text="Actor description"/><TextBox Text="{Binding ActorDescription}"/><Button Content="Upload actor reference…" Command="{Binding UploadActorCommand}"/><TextBlock Text="{Binding SelectedActorUrl}" Style="{StaticResource Hint}"/><Button Content="Load voices" Command="{Binding LoadVoicesCommand}"/><ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Name"/><TextBlock Text="Voice ID (optional)"/><TextBox Text="{Binding VoiceId}"/><ComboBox ItemsSource="{Binding UgcModes}" SelectedItem="{Binding UgcMode}"/><TextBlock Text="Requires Fal and ElevenLabs keys. Public gallery sharing is off." Style="{StaticResource Hint}"/><Button Content="Generate product video" Command="{Binding GenerateUgcCommand}" Style="{StaticResource Primary}"/></StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="260"/></Grid.RowDefinitions><TextBlock Text="Review narration" FontSize="22" Margin="0,0,0,12"/><TextBox Grid.Row="1" Text="{Binding UgcNarration}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><DockPanel Grid.Row="2"><WrapPanel DockPanel.Dock="Bottom"><Button Content="Play / pause" Command="{Binding PlayCreativeVideoCommand}"/><Button Content="Export product video…" Command="{Binding ExportUgcCommand}"/></WrapPanel><vlc:VideoView MediaPlayer="{Binding CreativePreview.Player}"/></DockPanel></Grid>
  </Grid></TabItem>
  <TabItem Header="DUBBING"><StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left"><TextBlock Text="Translate the voice" FontSize="26"/><TextBlock Text="Open a clip in the editor, then select its target language. Dubbing uses ElevenLabs and may incur provider charges." Style="{StaticResource Hint}"/><ComboBox ItemsSource="{Binding DubLanguages}" SelectedItem="{Binding TargetLanguage}"/><Button Content="Dub selected clip" Command="{Binding DubClipCommand}" Style="{StaticResource Primary}"/><TextBlock Text="{Binding UgcResult}" TextWrapping="Wrap"/></StackPanel></TabItem>
 </TabControl></DockPanel>
</UserControl>
