<UserControl x:Class="OpenShorts.Desktop.EditorTimelinePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop">
 <Border Style="{StaticResource EditorPanel}" Padding="0"><DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel Margin="8,7,8,5"><Button Content="↶" Command="{Binding UndoEditCommand}" Style="{StaticResource ToolButton}"/><Button Content="↷" Command="{Binding RedoEditCommand}" Style="{StaticResource ToolButton}"/><Button Content="＋ Add" Command="{Binding AddSegmentCommand}" Style="{StaticResource ToolButton}"/><Button Content="⋈ Split" Command="{Binding SplitSegmentCommand}" Style="{StaticResource ToolButton}"/><Button Content="Delete" ToolTip="Remove the selected video range. At least one range must remain." Command="{Binding RemoveSegmentCommand}" Style="{StaticResource ToolButton}"/><Button Content="← Earlier" Command="{Binding MoveUpCommand}" Style="{StaticResource ToolButton}"/><Button Content="Later →" Command="{Binding MoveDownCommand}" Style="{StaticResource ToolButton}"/><Button Content="Crop" Command="{Binding SelectEditorToolCommand}" CommandParameter="Crop" Style="{StaticResource ToolButton}"/><Button Content="Waveform / scenes" Command="{Binding LoadFeaturesCommand}" Style="{StaticResource ToolButton}"/><CheckBox Content="Snap" IsChecked="{Binding SnapEnabled}" Margin="5,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Zoom" Style="{StaticResource EditorLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider Width="85" Minimum="1" Maximum="32" Value="{Binding TimelineZoom}" Style="{StaticResource EditorSlider}" Margin="0"/><Button Content="Assets" Command="{Binding ToggleAssetsCommand}" Style="{StaticResource ToolButton}" Margin="8,0,5,0"/><Button Content="Properties" Command="{Binding ToggleInspectorCommand}" Style="{StaticResource ToolButton}"/></WrapPanel>
  <TextBlock Text="Ordered source ranges · linked audio · drag edges to trim, blocks to reorder, captions to retime · Ctrl+wheel zoom" Foreground="#94A3B8" FontSize="10" Margin="10,0,8,5"/>
 </StackPanel><StackPanel DockPanel.Dock="Bottom"><Slider Minimum="0" Maximum="1" Value="{Binding TimelinePan}" Style="{StaticResource EditorSlider}" ToolTip="Pan across the zoomed timeline" Margin="110,0,12,0"/><DockPanel Margin="8,0,8,5"><TextBlock Text="{Binding FeatureStatus}" Foreground="#94A3B8" FontSize="10" MaxHeight="24"/><Button Content="Save" Command="{Binding SaveEditorCommand}" Style="{StaticResource ToolButton}"/><Button Content="Reload" Command="{Binding ReloadDraftCommand}" Style="{StaticResource ToolButton}"/><Button Content="Reset to delivered" Command="{Binding ResetDeliveredDraftCommand}" Style="{StaticResource ToolButton}"/></DockPanel></StackPanel>
 <local:TimelineSurface Frames="{Binding TimelineFrames}" SourceThumbnail="{Binding SourceThumbnail,Converter={StaticResource MediaThumbnail}}" Segments="{Binding Segments}" Captions="{Binding Captions}" Effects="{Binding AutoEffects}" Playhead="{Binding TimelineSeconds}" Zoom="{Binding TimelineZoom,Mode=TwoWay}" PanFraction="{Binding TimelinePan,Mode=TwoWay}" SelectedSegment="{Binding SelectedSegment,Mode=TwoWay}" SelectedCaption="{Binding SelectedCaption,Mode=TwoWay}" Waveform="{Binding Waveform}" SceneBoundaries="{Binding SceneBoundaries}" IsEnabled="{Binding CanEdit}" SeekRequested="OnSeek"/>
 </DockPanel></Border>
</UserControl>
