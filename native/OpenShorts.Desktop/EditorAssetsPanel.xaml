<UserControl x:Class="OpenShorts.Desktop.EditorAssetsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop">
 <Border Style="{StaticResource EditorPanel}" Padding="8"><TabControl Style="{StaticResource EditorTabs}" SelectedIndex="{Binding AssetTab}">
  <TabItem Header="Media"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,12,0,8"><ComboBox Width="105" ItemsSource="{Binding MediaFilters}" SelectedItem="{Binding MediaFilter}" Margin="0,0,8,0"/><Button Content="＋ Import" Command="{Binding ImportEditorMediaCommand}" Style="{StaticResource ToolButton}"/><Button Content="↻" Command="{Binding LoadEditorMediaCommand}" Style="{StaticResource ToolButton}" ToolTip="Refresh project media"/></WrapPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><WrapPanel><Button Content="Preview" Command="{Binding PreviewMediaCommand}" Style="{StaticResource ToolButton}"/><Button Content="Add source range" Command="{Binding AddSourceRangeCommand}" Style="{StaticResource ToolButton}" ToolTip="Add a range from this project's retained source"/></WrapPanel><TextBlock Text="Video ranges share the retained source. Imported B-roll and images are stored and previewable; freeform compositing is not available." Style="{StaticResource Hint}" FontSize="10" Margin="0,8,0,0"/></StackPanel>
   <ListBox ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMedia}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,6"><Border Background="#1C2735" Height="72" CornerRadius="6"><Grid><TextBlock Text="▷" FontSize="30" Foreground="#08D5EE" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail,Converter={StaticResource MediaThumbnail}}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,5,0,2"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#94A3B8"/></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="Preview selected asset" Command="{Binding PreviewMediaCommand}"/><MenuItem Header="Show in Explorer" Command="{Binding RevealEditorMediaCommand}"/></ContextMenu></ListBox.ContextMenu></ListBox>
  </DockPanel></TabItem>
  <TabItem Header="Captions"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Caption transcript" Style="{StaticResource EditorHeading}"/><TextBox Text="{Binding CaptionSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search caption text" AutomationProperties.Name="Search captions"/><ComboBox ItemsSource="{Binding CaptionPresets}" SelectedItem="{Binding CaptionPreset}" IsEnabled="{Binding CanEdit}"/><WrapPanel><Button Content="Render preview" Command="{Binding RenderPreviewCommand}" Style="{StaticResource ToolButton}"/><Button Content="Hook / headline" Command="{Binding SelectEditorToolCommand}" CommandParameter="Effects" Style="{StaticResource ToolButton}"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding CaptionView}" SelectedItem="{Binding SelectedCaption}" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Start,StringFormat='Source {0:F2}s'}" Foreground="#08D5EE" FontSize="10"/><TextBlock Text="{Binding Text}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
  <TabItem Header="Audio"><ScrollViewer VerticalScrollBarVisibility="Auto"><local:EditorAudioPanel/></ScrollViewer></TabItem>
  <TabItem Header="Effects"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Button Content="AI Auto Edit" Command="{Binding SelectEditorToolCommand}" CommandParameter="AutoEdit"/><TextBlock Text="Framing &amp; captions" Style="{StaticResource EditorHeading}"/><Button Content="Crop &amp; focal point" Command="{Binding SelectEditorToolCommand}" CommandParameter="Crop"/><Button Content="Caption animations" Command="{Binding SelectEditorToolCommand}" CommandParameter="Captions"/><TextBlock Text="Source-backed clip tools" Style="{StaticResource EditorHeading}"/><TextBlock Text="Hook titles, scene crop overrides and the saved director plan are available in Properties → Effects." Style="{StaticResource Hint}"/><TextBlock Text="Scene-aware effects are editable in Properties → AI Edit. Speed ramps and freeform rotation are unavailable." Style="{StaticResource Hint}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Templates"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Caption presets" Style="{StaticResource EditorHeading}"/><WrapPanel><Button Content="Bold" Command="{Binding ApplyCaptionPresetCommand}" CommandParameter="bold-creator" Style="{StaticResource ToolButton}"/><Button Content="Minimal" Command="{Binding ApplyCaptionPresetCommand}" CommandParameter="clean-minimal" Style="{StaticResource ToolButton}"/><Button Content="Highlight" Command="{Binding ApplyCaptionPresetCommand}" CommandParameter="dynamic-highlight" Style="{StaticResource ToolButton}"/></WrapPanel><TextBlock Text="Video templates" Style="{StaticResource EditorHeading}"/><WrapPanel><Button Content="Load styles" Command="{Binding LoadProjectTemplatesCommand}" Style="{StaticResource ToolButton}"/><Button Content="Clear" Command="{Binding ClearTemplateCommand}" Style="{StaticResource ToolButton}"/></WrapPanel></StackPanel><Button DockPanel.Dock="Bottom" Content="Render selected template" Command="{Binding RenderPreviewCommand}" Style="{StaticResource Primary}" Margin="0,8,0,0"/><ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" VirtualizingPanel.VirtualizationMode="Recycling"/></DockPanel></TabItem>
 </TabControl></Border>
</UserControl>
