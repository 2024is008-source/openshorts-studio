<UserControl x:Class="OpenShorts.Desktop.ReadyClipSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Generation Mode" Style="{StaticResource ReadyHeading}"/><UniformGrid Columns="2"><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Mode,Converter={StaticResource ReadyChoice},ConverterParameter=clips,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="AI Clipper" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Separate Short Clips" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Mode,Converter={StaticResource ReadyChoice},ConverterParameter=highlights,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Sparkles" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="One Highlight Summary" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid><TextBlock Text="Create independent shorts, or combine important moments into one highlight summary." Style="{StaticResource ReadyHint}"/></StackPanel></Border><TextBlock Text="AI selects complete moments automatically. Choose Separate Short Clips or One Highlight Summary above; custom source ranges remain editable in Video Editor." Style="{StaticResource ReadyHint}"/><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Clip Duration" Style="{StaticResource ReadyHeading}"/><UniformGrid Columns="5"><RadioButton Style="{StaticResource ReadyChoiceCard}" IsEnabled="{Binding IsClips}" IsChecked="{Binding DurationSelection,Converter={StaticResource ReadyChoice},ConverterParameter=auto,Mode=TwoWay}"><TextBlock Text="Auto · Story" HorizontalAlignment="Center" FontSize="11"/></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsEnabled="{Binding IsClips}" IsChecked="{Binding DurationSelection,Converter={StaticResource ReadyChoice},ConverterParameter=15,Mode=TwoWay}"><TextBlock Text="15 seconds" HorizontalAlignment="Center" FontSize="11"/></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding DurationSelection,Converter={StaticResource ReadyChoice},ConverterParameter=30,Mode=TwoWay}"><TextBlock Text="30 seconds" HorizontalAlignment="Center" FontSize="11"/></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding DurationSelection,Converter={StaticResource ReadyChoice},ConverterParameter=60,Mode=TwoWay}"><TextBlock Text="60 seconds" HorizontalAlignment="Center" FontSize="11"/></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding DurationSelection,Converter={StaticResource ReadyChoice},ConverterParameter=custom,Mode=TwoWay}"><TextBlock Text="Custom" HorizontalAlignment="Center" FontSize="11"/></RadioButton></UniformGrid><Grid Margin="0,3,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Target length (seconds)" VerticalAlignment="Center" Foreground="#A9B8CA" FontSize="11"/><TextBox Style="{StaticResource ReadyNumberInput}" Grid.Column="1" IsEnabled="{Binding CanSetTarget}" Text="{Binding TargetSeconds,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0"/></Grid><TextBlock Text="Clips: 10–150 seconds. Summaries: 30–180 seconds. Targets follow complete sentences." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Aspect Ratio" Style="{StaticResource ReadyHeading}"/><UniformGrid Columns="3"><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=vertical,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Portrait" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="9:16 · Shorts / Reels" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=square,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Square" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="1:1 · Square" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Ratio,Converter={StaticResource ReadyChoice},ConverterParameter=horizontal,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Landscape" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="16:9 · Landscape" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid></StackPanel></Border><Expander Header="Advanced Options" IsExpanded="False" Margin="0,4,0,10"><StackPanel Margin="0,12,0,0"><UniformGrid Columns="2"><StackPanel Margin="0,0,14,0"><CheckBox Content="Automatic clip count" IsChecked="{Binding AutoCount}" Margin="0,4,0,9"/><TextBlock Text="Clip count (1–12; used when automatic is off)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding Count,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Minimum duration (5–175 s; blank = engine default)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding Minimum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><TextBlock Text="Maximum duration (10–180 s; blank = engine default)"/><TextBox Style="{StaticResource ReadyNumberInput}" Text="{Binding Maximum,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><Button Content="Reset duration band" Command="{Binding ClearBandCommand}" HorizontalAlignment="Left"/></StackPanel><StackPanel><TextBlock Text="Pacing"/><ComboBox ItemsSource="{Binding PacingModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Pacing}" Margin="0,4,0,12"/><TextBlock Text="Vertical layout"/><ComboBox ItemsSource="{Binding FramingPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Framing}" Margin="0,4,0,12"/><CheckBox Content="Create source-backed hook titles" IsChecked="{Binding AutoHook}" Margin="0,4,0,9"/><CheckBox Content="Trim silence at edit boundaries" IsChecked="{Binding TrimSilence}" Margin="0,4,0,9"/><CheckBox Content="Source already has burned-in captions" IsChecked="{Binding ExistingCaptions}" Margin="0,4,0,9"/><TextBlock Text="Source language is detected automatically." Style="{StaticResource ReadyHint}"/></StackPanel></UniformGrid></StackPanel></Expander></StackPanel></ScrollViewer></UserControl>