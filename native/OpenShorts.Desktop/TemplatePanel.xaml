<UserControl x:Class="OpenShorts.Desktop.TemplatePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Design library" Style="{StaticResource Title}"/><TextBlock Text="Choose a starter for new clips, or customize a style for your open project." Style="{StaticResource Hint}"/><WrapPanel><Button Content="Load project styles" Command="{Binding LoadProjectTemplatesCommand}"/><Button Content="Apply to project drafts" Command="{Binding ApplyTemplateToProjectCommand}"/><Button Content="Clear selection" Command="{Binding ClearTemplateCommand}"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"><ListBox.ItemTemplate><DataTemplate><Border Background="#1B2834" CornerRadius="8" Padding="20" Margin="0,4"><StackPanel><TextBlock Text="{Binding Name}" FontSize="23"/><TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
 <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Make it yours" FontSize="25" Margin="0,0,0,16"/><TextBlock Text="Open a generated clip to save custom templates in its project library." Style="{StaticResource Hint}"/><TextBlock Text="Style name"/><TextBox Text="{Binding TemplateName}"/><TextBlock Text="Font"/><ComboBox ItemsSource="{Binding CaptionFonts}" SelectedItem="{Binding TemplateFont}"/><TextBlock Text="Caption size"/><Slider Minimum="24" Maximum="240" Value="{Binding TemplateFontSize}"/><TextBlock Text="Primary accent · #RRGGBB"/><TextBox Text="{Binding TemplatePrimary}"/><TextBlock Text="Secondary accent"/><TextBox Text="{Binding TemplateSecondary}"/><TextBlock Text="Text color"/><TextBox Text="{Binding TemplateText}"/><CheckBox Content="Show text logo" IsChecked="{Binding TemplateLogoEnabled}"/><TextBox Text="{Binding TemplateLogo}"/><Button Content="Save as project style" Command="{Binding SaveCustomTemplateCommand}" Style="{StaticResource Primary}"/></StackPanel></ScrollViewer></Grid>
</UserControl>
