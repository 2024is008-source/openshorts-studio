<Window x:Class="OpenShorts.Desktop.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export video · OpenShorts Studio" Width="620" Height="730" MinWidth="540" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{StaticResource Base}" Foreground="{StaticResource Ink}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Export your video" Style="{StaticResource Title}"/><TextBlock Text="MP4 · H.264 video · AAC audio" Style="{StaticResource Hint}"/><TextBlock Text="File name" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding ExportName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Output folder" Style="{StaticResource EditorLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseExportFolderCommand}"/><TextBox Text="{Binding ExportFolder}"/></DockPanel><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Resolution" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding ExportSizes}" SelectedItem="{Binding ExportSize}"/><TextBlock Text="Encoder / GPU" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding ExportEncoder}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Frame rate" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding ExportFrameRates}" SelectedItem="{Binding ExportFrameRate}"/><TextBlock Text="Quality preset" Style="{StaticResource EditorLabel}"/><ComboBox ItemsSource="{Binding ExportQualityPresets}" SelectedItem="{Binding ExportQuality}"/></StackPanel></UniformGrid><TextBlock Text="{Binding HomeGpuStatus}" Foreground="{StaticResource Accent}"/><TextBlock Text="Auto follows the detected encoder policy. NVENC requests fall back to CPU if initialization fails. Source frame rate is preserved unless overridden." Style="{StaticResource Hint}"/><ProgressBar Height="5" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding ProgressUnknown}" Visibility="{Binding Busy,Converter={StaticResource Visible}}" Foreground="{StaticResource Accent}" Margin="0,16,0,10"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Foreground="#FFB4AB" TextWrapping="Wrap" Margin="0,10"/><WrapPanel Margin="0,18,0,0"><Button Content="Export MP4" Command="{Binding RenderExportCommand}" Style="{StaticResource Primary}"/><Button Content="Cancel processing" Command="{Binding CancelCommand}"/></WrapPanel><WrapPanel><Button Content="Open exported file" Command="{Binding OpenExportedFileCommand}"/><Button Content="Open folder" Command="{Binding OpenExportFolderCommand}"/></WrapPanel><TextBlock Text="Exports always render and validate the saved timeline before copying the final file. Progress comes from the engine; completion time is not estimated." Style="{StaticResource Hint}"/></StackPanel></ScrollViewer>
</Window>
