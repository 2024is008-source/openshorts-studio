<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop">
 <local:MediaThumbnailConverter x:Key="ClipThumbnail"/>
 <Style x:Key="ClipPanel" TargetType="Border"><Setter Property="Background" Value="#101B27"/><Setter Property="BorderBrush" Value="#263D50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
 <Style x:Key="ClipHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="ClipHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#9FB3C8"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,6"/></Style>
 <Style x:Key="ClipAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="#102A3A"/><Setter Property="BorderBrush" Value="#285067"/><Setter Property="Foreground" Value="#DCEAF7"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="MinHeight" Value="30"/></Style>
 <Style x:Key="ClipProgress" TargetType="ProgressBar"><Setter Property="Maximum" Value="100"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="#293340"/><Setter Property="Foreground" Value="#00CFE8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/><Border x:Name="Glow" Width="70" HorizontalAlignment="Left" Background="#00CFE8" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="Slide" X="-70"/></Border.RenderTransform></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Glow" Property="Visibility" Value="Visible"/><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-70" To="800" Duration="0:0:2"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ClipBadge" TargetType="Border"><Setter Property="Background" Value="#103348"/><Setter Property="BorderBrush" Value="#23506A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,0,5,0"/></Style>
 <Style x:Key="ClipPrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="#00D8EF"/><Setter Property="BorderBrush" Value="#25E8FF"/><Setter Property="Foreground" Value="#02212B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="ClipSlider" TargetType="Slider"><Setter Property="Height" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#00D8EF"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#00D8EF"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#354658"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ClipTagText" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="#A9D8E9"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="ClipInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="#112434"/><Setter Property="BorderBrush" Value="#29485D"/><Setter Property="Foreground" Value="#DCEAF6"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,6"/></Style>
 <Style x:Key="ClipCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Foreground" Value="#DCEAF6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="#102636" BorderBrush="#29485D" BorderThickness="1" CornerRadius="6" Padding="8,6"><Path Data="M0,0 L4,4 8,0" Stroke="#86ACC5" StrokeThickness="1" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#00D8EF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="9,7,22,7" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#102636" BorderBrush="#29485D" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ClipToggle" TargetType="CheckBox"><Setter Property="Foreground" Value="#CADCEA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel><Border DockPanel.Dock="Right" x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="#244051" Margin="10,0,0,0"><Ellipse x:Name="Dot" Fill="#E6F3FC" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#00CFE8"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>