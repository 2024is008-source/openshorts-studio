<UserControl x:Class="OpenShorts.Desktop.ClipToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <TabControl>
  <TabItem Header="HOOK"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Lead with the source" FontSize="20"/><TextBlock Text="Choose a complete quote from retained speech. The engine checks wording and subject overlap." Style="{StaticResource Hint}"/><Button Content="Find a source-backed hook" Command="{Binding SuggestHookCommand}"/><TextBox Text="{Binding HookText}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Start (s)"/><TextBox Text="{Binding HookStart,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><ComboBox ItemsSource="{Binding HookStyles}" SelectedItem="{Binding HookStyle}"/><ComboBox ItemsSource="{Binding HookPositions}" SelectedItem="{Binding HookPosition}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="Duration (s)"/><TextBox Text="{Binding HookDuration,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><ComboBox ItemsSource="{Binding HookSizes}" SelectedItem="{Binding HookSize}"/><ComboBox ItemsSource="{Binding HookAnimations}" SelectedItem="{Binding HookAnimation}"/></StackPanel></UniformGrid><WrapPanel><Button Content="Preview" Command="{Binding PreviewHookCommand}"/><Button Content="Apply hook" Command="{Binding ApplyHookCommand}"/><Button Content="Remove" Command="{Binding RemoveHookCommand}"/></WrapPanel><TextBlock Text="{Binding HookContext}" Style="{StaticResource Hint}"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="QUALITY"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding QualitySummary}" FontSize="19"/><WrapPanel Margin="0,12,0,0"><Button Content="Load report" Command="{Binding LoadQualityCommand}"/><Button Content="Validate again" Command="{Binding RecheckQualityCommand}"/><Button Content="AI polish (provider)" Command="{Binding AiPolishCommand}"/><Button Content="Remove burned captions" Command="{Binding RemoveCaptionsCommand}"/><Button Content="Export all clips" Command="{Binding ExportAllCommand}"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding QualityRows}" ItemTemplate="{StaticResource ReportTemplate}"/></DockPanel></TabItem>
  <TabItem Header="SCORES"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Advisory ranking" FontSize="19"/><TextBlock Text="Adjust weights without changing clip media. Missing evidence stays unassessed." Style="{StaticResource Hint}"/><ItemsControl ItemsSource="{Binding RankingWeights}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Name}"/><TextBox Text="{Binding Value,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Load scores" Command="{Binding LoadRankingCommand}"/><Button Content="Rescore" Command="{Binding RescoreRankingCommand}"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding RankingRows}" ItemTemplate="{StaticResource ReportTemplate}"/></DockPanel></TabItem>
  <TabItem Header="SCENES"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Scene framing" FontSize="19"/><TextBlock Text="Load retained scenes, then set each horizontal crop center from 0 (left) to 1 (right)." Style="{StaticResource Hint}"/><WrapPanel><Button Content="Load scenes" Command="{Binding LoadScenesCommand}"/><Button Content="Render scene crops" Command="{Binding ApplySceneCropsCommand}"/></WrapPanel></StackPanel><DataGrid ItemsSource="{Binding SceneRows}" IsReadOnly="{Binding Busy}"><DataGrid.Columns><DataGridTextColumn Header="Scene" Binding="{Binding Index}" IsReadOnly="True"/><DataGridTextColumn Header="In" Binding="{Binding Start}" IsReadOnly="True"/><DataGridTextColumn Header="Out" Binding="{Binding End}" IsReadOnly="True"/><DataGridTextColumn Header="Center" Binding="{Binding Center,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  <TabItem Header="DIRECTOR"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button Content="Load saved plan" Command="{Binding LoadDirectorCommand}"/><Button Content="Replay preview" Command="{Binding PreviewDirectorCommand}"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding DirectorSummary}" FontFamily="Consolas" FontSize="11"/></ScrollViewer></DockPanel></TabItem>
 </TabControl>
</UserControl>
