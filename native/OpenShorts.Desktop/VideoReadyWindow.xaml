<Window x:Class="OpenShorts.Desktop.VideoReadyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Video Ready · OpenShorts Studio" Width="1100" Height="700" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" WindowStartupLocation="CenterOwner" Foreground="#F4F4F7" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="12">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="VideoReadyTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border CornerRadius="13" BorderThickness="1" BorderBrush="#235062" Background="#1B1E25" Padding="22,20,22,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20" MouseLeftButtonDown="OnDrag" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="24" BorderBrush="#00CFE8" BorderThickness="2" Background="#10303A"><local:StudioIcon Kind="Check" Width="28" Height="28" Stroke="#00CFE8"/></Border><StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock Text="Video Ready" FontSize="27" FontWeight="Bold"/><TextBlock Text="Your video has been imported successfully. Configure clipping options to continue." Foreground="#AFBDCF" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Click="OnClose" Margin="0" Padding="5" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" AutomationProperties.Name="Close Video Ready"><local:StudioIcon Kind="Close" Width="18" Height="18" Stroke="#B8C5D4"/></Button></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"><StackPanel Width="280"><Border CornerRadius="9" Background="#10151C" BorderBrush="#3A4654" BorderThickness="1" Height="164" ClipToBounds="True"><Grid><Image Source="{Binding Thumbnail,Converter={StaticResource MediaThumbnail}}" Stretch="UniformToFill" Visibility="{Binding ShowThumbnail,Converter={StaticResource Visible}}"/><vlc:VideoView MediaPlayer="{Binding Player}" Visibility="{Binding PreviewActive,Converter={StaticResource Visible}}"/><Button Command="{Binding PlayCommand}" Visibility="{Binding ShowThumbnail,Converter={StaticResource Visible}}" Width="54" Height="48" Padding="10" Margin="0" Background="#C0131B22" BorderBrush="#467182" ToolTip="Play source preview"><local:StudioIcon Kind="Play" Width="27" Height="27" Stroke="White"/></Button></Grid></Border>
    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceInfo}" Style="{StaticResource ReadyHint}"/><TextBlock Text="{Binding FileInfo}" Style="{StaticResource ReadyHint}"/>
    <UniformGrid Columns="2"><Button Content="Play / pause" Command="{Binding PlayCommand}" Padding="10,8"/><Button Content="Change Video" Command="{Binding ChangeVideoCommand}" IsEnabled="{Binding CanEdit}" Padding="10,8"/></UniformGrid>
    <Border Style="{StaticResource ReadySection}" Margin="0,10,0,0"><StackPanel><TextBlock Text="Video / Audio Codec" Style="{StaticResource ReadyHeading}"/><TextBlock Text="{Binding CodecInfo}" Style="{StaticResource ReadyHint}"/></StackPanel></Border>
   </StackPanel></Viewbox>
   <TabControl Grid.Column="2" Style="{StaticResource ReadyTabs}" SelectedIndex="{Binding SelectedTab}"><TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="AI Clipper" Width="18" Height="18" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Clip Settings"/></StackPanel></TabItem.Header><local:ReadyClipSettings/></TabItem><TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Sparkles" Width="18" Height="18" Stroke="#B68AF5" Margin="0,0,9,0"/><TextBlock Text="AI Options"/></StackPanel></TabItem.Header><local:ReadyAiOptions/></TabItem><TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Settings" Width="18" Height="18" Stroke="#B8C5D4" Margin="0,0,9,0"/><TextBlock Text="Output Settings"/></StackPanel></TabItem.Header><local:ReadyOutputSettings/></TabItem></TabControl>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Error}" Foreground="#FFB6AD" TextWrapping="Wrap" MaxHeight="42"/><Border Height="1" Background="#343B45" Margin="0,10,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:StudioIcon Kind="Info" Width="17" Height="17" Stroke="#97B0C5" Margin="0,0,9,0"/><TextBlock Text="Category detection uses bounded evidence on import. Settings are saved before AI Clipper; clip generation waits for your confirmation." Foreground="#A8B8CA" FontSize="11" MaxWidth="470" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" Click="OnClose" IsEnabled="{Binding CanEdit}" Width="110" Padding="14,10" Margin="0,0,12,0"/><Button x:Name="ContinueButton" Command="{Binding OpenCommand}" Style="{StaticResource Primary}" Padding="18,10" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="Open in AI Clipper" VerticalAlignment="Center"/><local:StudioIcon Kind="Chevron" Width="16" Height="16" Stroke="#03212A" Margin="12,0,0,0"/></StackPanel></Button></StackPanel></Grid></StackPanel>
 </Grid></Border>
</Window>
