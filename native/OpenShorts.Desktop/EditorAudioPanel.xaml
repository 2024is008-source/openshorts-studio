<UserControl x:Class="OpenShorts.Desktop.EditorAudioPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,10,6,0"><TextBlock Text="Audio mix" Style="{StaticResource EditorHeading}"/><TextBlock Text="Original audio follows the video ranges." Style="{StaticResource Hint}"/><TextBlock Text="Preview volume · display only" Style="{StaticResource EditorLabel}"/><Slider Maximum="100" Value="{Binding PlaybackVolume}" Style="{StaticResource EditorSlider}"/>
 <CheckBox Content="Customize exported audio" IsChecked="{Binding CustomAudio}" IsEnabled="{Binding CanEdit}"/><StackPanel IsEnabled="{Binding CustomAudio}"><TextBlock Text="Export mix gain (0–2)" Style="{StaticResource EditorLabel}"/><Slider Maximum="2" Value="{Binding ExportAudioVolume}" Style="{StaticResource EditorSlider}"/><TextBox Text="{Binding ExportAudioVolume,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/><CheckBox Content="Mute exported mix" IsChecked="{Binding ExportAudioMute}"/><TextBlock Text="Fade in / out (seconds, 0–2)" Style="{StaticResource EditorLabel}"/><Slider Maximum="2" Value="{Binding ExportAudioFade}" Style="{StaticResource EditorSlider}"/><CheckBox Content="Normalize before mix gain" IsChecked="{Binding ExportAudioNormalize}"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Target LUFS" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding ExportAudioTarget,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="True peak dBTP" Style="{StaticResource EditorLabel}"/><TextBox Text="{Binding ExportAudioCeiling,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></StackPanel></UniformGrid><TextBlock Text="Background music" Style="{StaticResource EditorHeading}"/><TextBlock Text="{Binding MusicFile}" Foreground="{StaticResource Accent}" FontSize="11"/><WrapPanel><Button Content="Use selected audio" Command="{Binding UseSelectedMusicCommand}" Style="{StaticResource ToolButton}"/><Button Content="Remove music" Command="{Binding RemoveMusicCommand}" Style="{StaticResource ToolButton}"/></WrapPanel><TextBlock Text="Select an imported audio asset in Media. Music starts at zero, is trimmed/padded to the cut, and uses the existing ducked mix at 15% gain with normalization. Independent track positioning is unavailable." Style="{StaticResource Hint}" Margin="0,10,0,8"/></StackPanel><Button Content="Load original waveform" Command="{Binding LoadFeaturesCommand}"/><Button Content="Render audio preview" Command="{Binding RenderPreviewCommand}" Style="{StaticResource Primary}"/></StackPanel>
</UserControl>
