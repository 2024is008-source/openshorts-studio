<UserControl x:Class="OpenShorts.Desktop.ReadyAiOptions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Video Category" Style="{StaticResource ReadyHeading}"/><ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PrimaryCategory}"/><ComboBox ItemsSource="{Binding Subcategories}" SelectedItem="{Binding Subcategory}"/><Button Content="Detect category with Gemini" Command="{Binding DetectCategoryCommand}"/><Button Content="Use suggested category" Command="{Binding UseDetectedCategoryCommand}"/><TextBlock Text="{Binding CategoryExplanation}" Style="{StaticResource ReadyHint}" TextWrapping="Wrap"/><TextBlock Text="Manual selections take priority. Adaptive analysis uses selective visual verification. Other analysis modes retain their existing behavior." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Analysis Depth" Style="{StaticResource ReadyHeading}"/><UniformGrid Columns="2"><RadioButton Style="{StaticResource ReadyChoiceCard}" IsEnabled="{Binding IsClips}" IsChecked="{Binding Analysis,Converter={StaticResource ReadyChoice},ConverterParameter=transcript,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Audio" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Fast · Transcript Focus" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ReadyChoiceCard}" IsChecked="{Binding Analysis,Converter={StaticResource ReadyChoice},ConverterParameter=hybrid,Mode=TwoWay}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Brain" Width="21" Height="21" Stroke="#00CFE8" Margin="0,0,9,0"/><TextBlock Text="Balanced · Video + Speech" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid><TextBlock Text="Balanced analysis can use more time and Gemini API quota. Highlight summaries require Balanced analysis." Style="{StaticResource ReadyHint}"/><ComboBox SelectedValue="{Binding Analysis}" SelectedValuePath="Tag"><ComboBoxItem Content="Adaptive · Economy" Tag="adaptive-economy"/><ComboBoxItem Content="Adaptive · Balanced" Tag="adaptive-balanced"/><ComboBoxItem Content="Adaptive · Quality" Tag="adaptive-quality"/><ComboBoxItem Content="Legacy · Transcript" Tag="transcript"/><ComboBoxItem Content="Legacy · Full video comparison" Tag="hybrid"/></ComboBox><TextBlock Text="Adaptive modes use bounded selective analysis." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="AI Provider" Style="{StaticResource ReadyHeading}"/><TextBlock Text="Gemini" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource ReadyHint}"/><TextBlock Text="The engine uses its configured Gemini model. Keys are protected by Windows and never shown here. Auto Detect performs bounded category classification after import; full clip analysis waits for Generate Clips." Style="{StaticResource ReadyHint}"/></StackPanel></Border><Border Style="{StaticResource ReadySection}"><StackPanel><TextBlock Text="Story &amp; Selection" Style="{StaticResource ReadyHeading}"/><TextBlock Text="Category-specific story structures guide source-grounded selection; missing story beats are never invented." Style="{StaticResource ReadyHint}"/><TextBlock Text="Choose a category/subcategory above to override the automatic suggestion. The shared engine preserves complete moments and avoids repeated content." Styl