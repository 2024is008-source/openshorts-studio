<UserControl x:Class="OpenShorts.Desktop.GenerationStepper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop">
 <UserControl.Resources>
  <Style x:Key="Step" TargetType="Border"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="18"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#00CFE8"/><Setter Property="Background" Value="#14352C"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
  <Style x:Key="StepLabel" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Foreground" Value="#BCC9D8"/></Style>
 </UserControl.Resources>
 <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch" MinWidth="260">
  <Border Height="1" Background="#246570" Margin="40,18,40,0" VerticalAlignment="Top"/>
  <UniformGrid Columns="4">
   <StackPanel><Border Style="{StaticResource Step}"><TextBlock Text="{Binding SelectVideoStep}" Foreground="#00D8EF" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="1. Select Video" Style="{StaticResource StepLabel}"/></StackPanel>
   <StackPanel><Border Style="{StaticResource Step}"><TextBlock Text="{Binding SettingsStep}" Foreground="#00D8EF" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="2. Settings" Style="{StaticResource StepLabel}"/></StackPanel>
   <StackPanel><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Step}"><Setter Property="BorderBrush" Value="#00CFE8"/><Setter Property="Background" Value="#123640"/><Style.Triggers><DataTrigger Binding="{Binding GenerationState}" Value="failed"><Setter Property="BorderBrush" Value="#EF4444"/><Setter Property="Background" Value="#40282D"/></DataTrigger><DataTrigger Binding="{Binding GenerationState}" Value="cancelled"><Setter Property="BorderBrush" Value="#EF4444"/><Setter Property="Background" Value="#40282D"/></DataTrigger><DataTrigger Binding="{Binding GenerationState}" Value="completed"><Setter Property="BorderBrush" Value="#00CFE8"/><Setter Property="Background" Value="#14352C"/></DataTrigger></Style.Triggers></Style></Border.Style><local:LucideIcon Kind="{Binding GenerationStepIcon}" Stroke="#00CFE8" Width="18" Height="18"/></Border><TextBlock Text="3. Generating" Style="{StaticResource StepLabel}"/></StackPanel>
   <StackPanel><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Step}"><Setter Property="BorderBrush" Value="#637185"/><Setter Property="Background" Value="#242B35"/><Style.Triggers><DataTrigger Binding="{Binding ClipperReview}" Value="True"><Setter Property="BorderBrush" Value="#00CFE8"/><Setter Property="Background" Value="#123640"/></DataTrigger></Style.Triggers></Style></Border.Style><local:LucideIcon Kind="Templates" Stroke="#A7B4C7" Width="16" Height="16"/></Border><TextBlock Text="4. Review" Style="{StaticResource StepLabel}"/></StackPanel>
  </UniformGrid>
 </Grid>
</UserControl>