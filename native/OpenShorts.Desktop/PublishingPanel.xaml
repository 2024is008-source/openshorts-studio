<UserControl x:Class="OpenShorts.Desktop.PublishingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Publish &amp; schedule" Style="{StaticResource Title}"/><TextBlock Text="Publish the current rendered clip through your Upload-Post account. Render final before publishing changes." Style="{StaticResource Hint}"/><CheckBox Content="Enable provider actions for this session" IsChecked="{Binding ProviderActionsAuthorized}"/><TextBlock Text="Provider profile ID"/><TextBox Text="{Binding PublishingProfile}"/><Button Content="Load connected profiles" Command="{Binding LoadSocialProfilesCommand}"/><TextBlock Text="Title"/><TextBox Text="{Binding PublishingTitle}"/><TextBlock Text="Description"/><TextBox Text="{Binding PublishingDescription}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><CheckBox Content="YouTube" IsChecked="{Binding PublishYoutube}"/><CheckBox Content="Instagram" IsChecked="{Binding PublishInstagram}" Margin="12,6"/><CheckBox Content="TikTok" IsChecked="{Binding PublishTiktok}"/></WrapPanel><TextBlock Text="Schedule · ISO 8601 with offset (empty = now)"/><TextBox Text="{Binding ScheduledDate}" ToolTip="Example: 2026-12-20T18:30:00+05:30"/><TextBlock Text="Timezone (provider IANA name)"/><TextBox Text="{Binding PublishingTimezone}"/><Button Content="Review &amp; publish…" Command="{Binding PublishClipCommand}" Style="{StaticResource Primary}"/></StackPanel></ScrollViewer>
 <DockPanel Grid.Column="2"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding PublishingStatus}" FontSize="18" Margin="0,0,0,16"/><WrapPanel><Button Content="Analytics" Command="{Binding LoadSocialAnalyticsCommand}"/><Button Content="Scheduled posts" Command="{Binding LoadScheduledPostsCommand}"/></WrapPanel></StackPanel><TabControl><TabItem Header="PROVIDER REPORT"><ListBox ItemsSource="{Binding PublishingReports}" ItemTemplate="{StaticResource ReportTemplate}"/></TabItem><TabItem Header="SCHEDULED POSTS"><DockPanel><Button DockPanel.Dock="Bottom" Content="Cancel selected schedule…" Command="{Binding CancelScheduledPostCommand}"/><DataGrid ItemsSource="{Binding ScheduledPosts}" SelectedItem="{Binding SelectedScheduledPost}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Scheduled" Binding="{Binding Scheduled}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem></TabControl></DockPanel>
 </Grid>
</UserControl>
