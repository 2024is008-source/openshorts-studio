<UserControl x:Class="OpenShorts.Desktop.PreviewOverlayControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" Visibility="{Binding IsEditor,Converter={StaticResource Visible}}"><Grid><Border Background="#080D15"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding PreviewImage,Converter={StaticResource MediaThumbnail},ConverterParameter=1024}" Stretch="Uniform"/></Border><local:PreviewGuides SafeZone="{Binding SafeZones}" Crop="{Binding CropGuides}" IsHitTestVisible="False"/>
         <TextBlock Text="{Binding PreviewHeadline}" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Top" Margin="20,45,20,0" IsHitTestVisible="False"/>
         <Border Background="#C0000000" CornerRadius="5" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,70"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding PreviewCaption}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding PreviewCaption}" Foreground="#08D5EE" FontSize="22" FontWeight="Bold" TextAlignment="Center"/></Border>
        </Grid></UserControl>