<UserControl x:Class="OpenShorts.Desktop.ReviewDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop"><DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><Button Command="{Binding ExportReviewSelectedCommand}" Style="{StaticResource ClipPrimary}" Padding="10,8" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><local:LucideIcon Kind="Import" Width="16" Height="16" Stroke="#03212A" Margin="0,0,7,0"/><TextBlock Text="Export selected"/></StackPanel></Button><Button Content="Open in Video Editor" Command="{Binding EditReviewCommand}" CommandParameter="{Binding ReviewSelected}" Style="{StaticResource ClipAction}"/><WrapPanel><Button Content="Export all" Command="{Binding ExportReviewAllCommand}" Style="{StaticResource ClipAction}"/><Button Content="Retry failed exports" Command="{Binding RetryReviewExportsCommand}" Style="{StaticResource ClipAction}"/></WrapPanel><Button Content="Cancel active export" Command="{Binding CancelCommand}" Style="{StaticResource ClipAction}" Visibility="{Binding Busy,Converter={StaticResource Visible}}"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <DockPanel><TextBlock Text="Clip Details" Style="{StaticResource ClipHeading}"/><Button Command="{Binding ReloadReviewCommand}" Style="{StaticResource ClipAction}" Padding="2" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" ToolTip="Refresh saved results"><local:LucideIcon Kind="refresh-cw" Width="13" Height="13" Stroke="#8DBCD7"/></Button></DockPanel>
 <TextBlock Text="{Binding ReviewSelected.Record.Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><WrapPanel Margin="0,7,0,12"><Border CornerRadius="12" BorderBrush="#269D6D" BorderThickness="1" Padding="7,3"><TextBlock Text="{Binding ReviewSelected.Record.ScoreLabel}" Foreground="#5BE49D" FontSize="11"/></Border><TextBlock Text="AI clip score" Style="{StaticResource ClipHint}" Margin="8,4,0,0"/></WrapPanel>
 <TextBlock Style="{StaticResource ClipHint}"><Run Text="{Binding ReviewSelected.Record.DurationLabel,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReviewSelected.Record.Resolution,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReviewSelected.Record.Format,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding ReviewSelected.Record.Metrics}" Style="{StaticResource ClipHint}"/>
 <StackPanel Orientation="Horizontal" Margin="0,8,0,5"><local:LucideIcon Kind="sparkles" Width="13" Height="13" Stroke="#00D8EF" Margin="0,0,6,0"/><TextBlock Text="Generated Hook" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBox Style="{StaticResource ClipInput}" Text="{Binding ReviewSelected.Record.Hook,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" Background="#142433" Padding="8" FontSize="11"/>
 <StackPanel IsEnabled="{Binding CanReviewExport}"><TextBlock Text="Caption Preset" Style="{StaticResource ClipHint}" Margin="0,12,0,3"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewCaptionChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ReviewCaptionStyle}" FontSize="11" Margin="0,0,0,5"/><TextBlock Text="Framing Mode" Style="{StaticResource ClipHint}"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewFramingChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ReviewFramingStyle}" FontSize="11" Margin="0,0,0,5"/><TextBlock Text="Audio Mastering" Style="{StaticResource ClipHint}"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewAudioStyles}" SelectedItem="{Binding ReviewAudioStyle}" FontSize="11" Margin="0,0,0,5"/><Button Content="Apply &amp; preview" Command="{Binding ApplyReviewStylesCommand}" Style="{StaticResource ClipAction}"/><TextBlock Text="Renders a fresh preview of framing, captions and audio. Export keeps these saved settings." Style="{StaticResource ClipHint}"/></StackPanel>
 <TextBlock Text="Tags" Style="{StaticResource ClipHint}"/><TextBlock Text="{Binding ReviewSelected.Record.Tags}" FontSize="10" Foreground="#9CCDE4" TextWrapping="Wrap"/><Separator Margin="0,10"/>
   <TextBlock Text="Export Options" Style="{StaticResource ClipHeading}" Margin="0,12,0,6"/>
   <StackPanel IsEnabled="{Binding CanImport}"><TextBlock Text="MP4 · H.264 · AAC" Style="{StaticResource ClipHint}"/><TextBlock Text="Filename"/><TextBox Style="{StaticResource ClipInput}" Text="{Binding ExportName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6"/>
   <TextBlock Text="Destination folder"/><DockPanel Margin="0,4,0,6"><Button DockPanel.Dock="Right" Command="{Binding BrowseExportFolderCommand}" Style="{StaticResource ClipAction}" ToolTip="Choose export folder"><local:LucideIcon Kind="Folder" Width="16" Height="16" Stroke="#BAC7D7"/></Button><TextBox Style="{StaticResource ClipInput}" Text="{Binding ExportFolder,UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ExportFolder}"/></DockPanel>
   <TextBlock Text="Resolution"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ExportSizes}" SelectedItem="{Binding ExportSize}" Margin="0,4,0,6" FontSize="11"/>
   <TextBlock Text="Frame rate"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ExportFrameRates}" SelectedItem="{Binding ExportFrameRate}" Margin="0,4,0,6"/>
   <TextBlock Text="H.264 encoder · auto / CPU / NVIDIA" Style="{StaticResource ClipHint}"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewEncoderChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ExportEncoder}" Margin="0,0,0,6"/>
   <TextBlock Text="Quality"/><ComboBox Style="{StaticResource ClipCombo}" ItemsSource="{Binding ReviewQualityChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ExportQuality}" Margin="0,4,0,6"/>
   <CheckBox Style="{StaticResource ClipToggle}" Content="Include captions" IsChecked="{Binding ReviewIncludeCaptions}"/><TextBlock Text="Caption inclusion updates each saved timeline with revision protection. Existing files receive a numbered filename." Style="{StaticResource ClipHint}"/>
   </StackPanel>
</StackPanel></ScrollViewer></DockPanel></UserControl>