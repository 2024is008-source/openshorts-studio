<Window x:Class="OpenShorts.Desktop.ImportVideoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" Title="Import Video · OpenShorts Studio" Width="620" Height="640" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner" Foreground="#F3F5FA" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" AllowDrop="True" Drop="OnDrop">
 <Window.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="#171A20"/><Setter Property="BorderBrush" Value="#363A43"/><Setter Property="Foreground" Value="#CAD4E3"/><Setter Property="Margin" Value="0"/></Style>
  <Style x:Key="ImportSecondary" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Background" Value="#20252D"/><Setter Property="BorderBrush" Value="#343D49"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ImportPrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#00C6DE"/><Setter Property="Foreground" Value="#00171D"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ImportTab" TargetType="RadioButton"><Setter Property="Foreground" Value="#ABBACC"/><Setter Property="Padding" Value="12,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent"><Border x:Name="Tab" Background="#1B1E25" BorderBrush="#343B46" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#12303B"/><Setter TargetName="Underline" Property="Background" Value="#00CBE4"/><Setter Property="Foreground" Value="#00D2EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#225064" BorderThickness="1" CornerRadius="14" Padding="26,24,26,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#22252E"/><GradientStop Color="#181D24" Offset="0.6"/><GradientStop Color="#12242D" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnTitleDrag" Background="Transparent" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#073F57" CornerRadius="24"><local:StudioIcon Kind="Import" Width="26" Height="26" Stroke="#00CFE8"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Import Video" FontSize="25" FontWeight="Bold"/><TextBlock Text="Add a local file or paste a video URL to start clipping." FontSize="12" Foreground="#AFBED2" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Click="OnClose" Background="Transparent" BorderBrush="Transparent" Padding="3" Margin="0" VerticalAlignment="Top" AutomationProperties.Name="Close import"><local:StudioIcon Kind="Close" Width="16" Height="16" Stroke="#B7C4D4"/></Button></Grid>
   <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Center"><StackPanel Width="566">
    <UniformGrid Columns="2" Margin="0,0,0,22" IsEnabled="{Binding CanInteract}"><RadioButton Style="{StaticResource ImportTab}" IsChecked="{Binding BrowseTab,Mode=OneWay}" Click="OnBrowseTab"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Import" Width="18" Height="18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Browse File" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource ImportTab}" IsChecked="{Binding UrlTab,Mode=OneWay}" Click="OnUrlTab"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Link" Width="19" Height="19" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Video URL" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid>
    <StackPanel Visibility="{Binding ShowDropTarget,Converter={StaticResource Visible}}"><Border BorderBrush="#344653" BorderThickness="1" CornerRadius="9" Background="#1B222A" Padding="20"><StackPanel HorizontalAlignment="Center"><local:StudioIcon Kind="Import" Width="30" Height="30" Stroke="#00CDE5" Margin="0,0,0,12"/><TextBlock Text="Drag and drop a video here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="MP4, MOV, MKV, WEBM, AVI or M4V · Up to 2 GB / 2 hours" Foreground="#9EADC1" FontSize="11" Margin="0,8,0,16"/><Button Content="Browse Files" Command="{Binding BrowseCommand}" Style="{StaticResource ImportSecondary}" HorizontalAlignment="Center"/></StackPanel></Border></StackPanel>
    <StackPanel Visibility="{Binding UrlTab,Converter={StaticResource Visible}}"><TextBlock Text="Video URL" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/><Border Background="#171A20" BorderBrush="#363A43" BorderThickness="1" CornerRadius="7" Height="46" IsEnabled="{Binding CanInteract}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><local:StudioIcon Kind="Link" Width="18" Height="18" Stroke="#AABBCD"/><TextBox Grid.Column="1" Style="{x:Null}" Text="{Binding Url,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#CAD4E3" CaretBrush="#00CFE8" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" AutomationProperties.Name="Video URL"/><Button Grid.Column="2" Command="{Binding PasteCommand}" Style="{StaticResource ImportSecondary}" Margin="4" Padding="8,5"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Copy" Width="15" Height="15" Stroke="#D5E2ED" Margin="0,0,7,0"/><TextBlock Text="Paste"/></StackPanel></Button></Grid></Border><TextBlock Text="Paste a public YouTube, TikTok, Instagram, or direct video URL." Foreground="#9AAFC4" FontSize="11" Margin="0,7,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding RightsConfirmed}" IsEnabled="{Binding CanInteract}" Foreground="#B4C3D4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="I have permission to download and use this video." TextWrapping="Wrap"/></CheckBox><Button Grid.Column="1" Content="Fetch &amp; Download" Command="{Binding FetchCommand}" Style="{StaticResource ImportSecondary}"/></Grid></StackPanel>
    <Border Background="#19232C" BorderBrush="#34434F" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasPreview,Converter={StaticResource Visible}}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#12171D" CornerRadius="7" Height="84" ClipToBounds="True"><Grid><local:StudioIcon Kind="Video Editor" Width="28" Height="28" Stroke="#4A6578"/><Image Source="{Binding Thumbnail,Converter={StaticResource MediaThumbnail}}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/><TextBlock Text="{Binding Details}" Foreground="#A6B9CB" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Grid><TextBlock Text="{Binding Status}" Foreground="#E0E8F0" FontSize="11" Margin="0,10,0,7" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Style="{x:Null}" Minimum="0" Maximum="100" Height="8" Value="{Binding Percentage}" IsIndeterminate="{Binding ProgressUnknown}" Foreground="#00CBE4" Background="#263846"/><TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="11" Margin="10,0,0,0" Foreground="#C6D6E5"/></Grid><TextBlock Text="{Binding BytesDescription}" Foreground="#9FB5CA" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
    
   </StackPanel></Viewbox>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><UniformGrid Columns="2"><Button Content="Cancel" Click="OnClose" Style="{StaticResource ImportSecondary}" Margin="0,0,7,0"/><Button Command="{Binding OpenCommand}" Style="{StaticResource ImportPrimary}" Margin="7,0,0,0"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="AI Clipper" Width="17" Height="17" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,9,0"/><TextBlock Text="Continue to settings" VerticalAlignment="Center"/></StackPanel></Button></UniformGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><local:StudioIcon Kind="Info" Width="12" Height="12" Stroke="#97B0C5" Margin="0,0,6,0"/><TextBlock Text="After import, review your clipping settings before continuing." Foreground="#97B0C5" FontSize="11"/></StackPanel></StackPanel>
  </Grid>
 </Border>
</Window>
