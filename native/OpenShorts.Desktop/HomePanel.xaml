<UserControl x:Class="OpenShorts.Desktop.HomePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenShorts.Desktop" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<UserControl.Resources><Style x:Key="HeroImport" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#00D0E7"/><Setter Property="Foreground" Value="#03232C"/><Setter Property="BorderBrush" Value="#1CE6F2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CTA" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CTA" Property="Background" Value="#32E3F0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CTA" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">7</sys:Double>
 <Style x:Key="Surface" TargetType="Border"><Setter Property="Background" Value="#1C1D20"/><Setter Property="BorderBrush" Value="#35363C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="14"/></Style>
 <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Background" Value="#202125"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#142E3E"/><Setter TargetName="Card" Property="BorderBrush" Value="#2A6A7D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="QuickActionCard" TargetType="Button" BasedOn="{StaticResource CardAction}"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#203A4B"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#102433"/><GradientStop Color="#0C1B27" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style><Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource LinkBtn}"><Setter Property="Foreground" Value="#00D4EA"/><Setter Property="FontSize" Value="11"/></Style>
 <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="#122737"/></Style>
 <Style x:Key="SideTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,13"/></Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
</UserControl.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition x:Name="StatusColumn" Width="270"/></Grid.ColumnDefinitions>
 <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
  <Border x:Name="HeroBanner" Height="246" Style="{StaticResource Surface}" Padding="0" BorderBrush="#1C3548" Background="#081725" Margin="0,0,0,18"><Grid><local:HeroBackdrop IsHitTestVisible="False"/><Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width=".95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="TURN LONG VIDEOS INTO SHORTS" Foreground="#A5AEC4" FontSize="10" Margin="0,0,0,10"/><TextBlock x:Name="HeroTitle" FontSize="29" FontWeight="Bold" LineHeight="35">Create engaging<LineBreak/>short clips <Run Text="with AI" Foreground="#00D5EA"/></TextBlock><TextBlock Text="Automatically find the best moments, add captions, reframe for every platform, and export high-quality clips." Foreground="#B8BBC5" FontSize="12" Margin="0,10,0,16" MaxWidth="355" HorizontalAlignment="Left"/><WrapPanel><Button Command="{Binding ImportCommand}" x:Name="HeroImportButton" Style="{StaticResource HeroImport}" Width="160" Height="36" Padding="13,8" Margin="0,0,9,0"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="Import" Width="16" Height="16" Stroke="#03232C" Margin="0,0,7,0"/><TextBlock Text="Import a Video" FontSize="12"/></StackPanel></Button><Button Click="OnQuickTour" x:Name="HeroTourButton" Style="{StaticResource SmallAction}" Width="146" Height="36" Background="#102131" BorderBrush="#20384B" Padding="11,8"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="PlayCircle" Width="16" Height="16" Stroke="#C7D7E4" Margin="0,0,6,0"/><TextBlock Text="Quick tour"/></StackPanel></Button></WrapPanel></StackPanel><local:HeroArtwork Grid.Column="1" Margin="0,-8,-10,-8"/>
   </Grid></Grid>
  </Border>
  <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="Get started in a few simple steps." FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="Quick Start" Style="{StaticResource SectionTitle}"/></DockPanel>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource QuickActionCard}" Command="{Binding ImportCommand}" MinHeight="88"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="60" Height="60" CornerRadius="10" BorderBrush="#0B568A" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#084A83"/><GradientStop Color="#05315E" Offset="1"/></LinearGradientBrush></Border.Background><local:StudioIcon Kind="Import" Width="32" Height="32" Stroke="#00CDFF"/></Border><StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center"><TextBlock Text="Import a Source Video" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Upload a video from your computer to get started with AI clipping." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="12" Height="16" Stroke="#A9AFBC"/></Grid></Button><Button Grid.Column="2" Style="{StaticResource QuickActionCard}" Command="{Binding NavigateHomeCommand}" CommandParameter="AI Clipper" MinHeight="88"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="60" Height="60" CornerRadius="10" BorderBrush="#086173" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#045466"/><GradientStop Color="#023640" Offset="1"/></LinearGradientBrush></Border.Background><local:StudioIcon Kind="AI Clipper" Width="32" Height="32" Stroke="#00DCF2"/></Border><StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center"><TextBlock Text="Create AI Clips" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Let AI find the best moments, add captions and reframe automatically." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="12" Height="16" Stroke="#A9AFBC"/></Grid></Button><Button Grid.Column="4" Style="{StaticResource QuickActionCard}" Command="{Binding NavigateHomeCommand}" CommandParameter="Templates" MinHeight="88"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><Border Width="60" Height="60" CornerRadius="10" BorderBrush="#562486" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#451B78"/><GradientStop Color="#290E4B" Offset="1"/></LinearGradientBrush></Border.Background><local:StudioIcon Kind="Templates" Width="32" Height="32" Stroke="#B34EFF"/></Border><StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center"><TextBlock Text="Start from Template" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Use a professional template to create polished short videos quickly." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><local:StudioIcon Grid.Column="2" Kind="Chevron" Width="12" Height="16" Stroke="#A9AFBC"/></Grid></Button></Grid>
 <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="View All ›" Style="{StaticResource Link}" Command="{Binding NavigateHomeCommand}" CommandParameter="Projects"/><TextBlock Text="Recent Projects" Style="{StaticResource SectionTitle}"/></DockPanel>
 <ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,0,-10,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CardAction}" Padding="8" Margin="0,0,10,0" Command="{Binding DataContext.OpenHomeProjectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Grid Height="94"><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Border Background="#30323A" CornerRadius="7" ClipToBounds="True"><Grid><local:StudioIcon Kind="Video Editor" Width="30" Height="30" Stroke="#778299"/><Image Source="{Binding Thumbnail,Converter={StaticResource MediaThumbnail}}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="12,2,0,0"><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding Updated}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/><Border Background="#122737" BorderBrush="#203A4B" BorderThickness="1" CornerRadius="5" Width="78" Height="26" HorizontalAlignment="Left"><TextBlock Text="Open" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Border Padding="18" MinHeight="104"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Surface}"><Style.Triggers><DataTrigger Binding="{Binding HomeHasProjects}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:StudioIcon Kind="Projects" Width="28" Height="28" Stroke="#88A6DF"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Your next story starts here" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Import a video to create your first project. Your saved work will appear here." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="2" Content="Import Video" Command="{Binding ImportCommand}" Style="{StaticResource Primary}" Height="34" Padding="12,6" VerticalAlignment="Center" Margin="0"/></Grid></Border>
 <DockPanel Margin="0,18,0,10"><Button DockPanel.Dock="Right" Content="View All Exports ›" Style="{StaticResource Link}" Command="{Binding NavigateHomeCommand}" CommandParameter="Projects"/><TextBlock Text="Recent Exports" Style="{StaticResource SectionTitle}"/></DockPanel>
 <Border Style="{StaticResource Surface}" Padding="0" MinHeight="118"><StackPanel>
 <Grid Background="#232429" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width=".85*"/><ColumnDefinition Width=".65*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".7*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Duration" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Format" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Resolution" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="Size" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="Exported" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0" VerticalAlignment="Center"/></Grid><ItemsControl ItemsSource="{Binding RecentExports}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CardAction}" Background="Transparent" BorderThickness="0" Padding="10,9" Command="{Binding DataContext.OpenHomeExportCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width=".85*"/><ColumnDefinition Width=".65*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width=".7*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayTitle}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Length}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="{Binding Format}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding Resolution}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="4" Text="{Binding FileSize}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="5" Text="{Binding Exported}" FontSize="10" Foreground="{StaticResource Muted}"/><local:StudioIcon Grid.Column="6" Kind="Play" Width="16" Height="16" Stroke="#9BB8ED"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <StackPanel x:Name="EmptyExports" Orientation="Horizontal" Margin="18,22"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HomeHasExports}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><local:StudioIcon Kind="Video Editor" Width="22" Height="22" Stroke="#72798A" Margin="0,0,10,0"/><TextBlock Text="Your exported clips will appear here." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
 </StackPanel></Border><TextBlock Text="{Binding HomeLibrarySummary}" Foreground="#777B88" FontSize="9" Margin="2,9,0,12"/>
 </StackPanel></ScrollViewer>
 <local:DesktopStatusPanel x:Name="DesktopStatus" Grid.Column="2"/>
</Grid></UserControl>
