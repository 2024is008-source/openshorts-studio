# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Rendering execution and resource policy (TASK-010). CPU remains the default.
# FFMPEG_ENCODER=x264
# x264, nvenc, auto. NVENC uses a real portrait initialization probe and
# retries a failed session once on CPU at the matching quality tier.
# FFMPEG_X264_PRESET=fast
# Optional x264 override: ultrafast/superfast/veryfast/faster/fast/medium/slow/slower/veryslow.
# Leave unset to preserve the existing per-stage/studio speed presets.
# FFMPEG_NVENC_PRESET=p4
# Optional p1..p7 override; unset preserves existing standard/studio GPU presets.
# FFMPEG_THREADS=4
# RENDER_MAX_ENCODERS=2
# CLIP_WORKERS=2
# Bounds: encoder slots/workers 1..4, encode threads 1..16. Per Python process.
# RENDER_STRICT_OVERLAYS=1
# Set 0 to restore legacy missing-caption fallback; raster checks still apply.
# Optional Remotion service (installed Windows version encodes H.264 on CPU):
# RENDER_SERVICE_WORKERS=1
# REMOTION_CONCURRENCY=2
# REMOTION_X264_PRESET=medium
# REMOTION_TIMEOUT_SECONDS=600

# Local post-render validation. Hard technical failures block export completion.
# Values are bounded; see docs/TASK-002.md for limits and report/recheck APIs.
# QUALITY_DURATION_TOLERANCE=0.35
# QUALITY_AV_TOLERANCE=0.35
# QUALITY_MAX_SAMPLES=8
# QUALITY_TIMEOUT_SECONDS=45

# Sentence-aware clip selection (TASK-003). Set 0 for legacy word snapping.
# CLIP_STORY_AWARE=1
# Optional soft duration target; dashboard presets: 15, 30, 45, 60, custom.
# Use compatible CLIP_MIN_SECONDS / CLIP_MAX_SECONDS for CLI hard limits.
# CLIP_TARGET_SECONDS=30

# Story selection policy: auto, challenge, emotional, comedy, podcast, educational.
# Hybrid reuses the existing cached chapter video/audio analysis; transcript mode
# remains the default and explicitly leaves unavailable visual metrics unassessed.
# STORY_MODE=auto
# ANALYSIS_MODE=hybrid
# Optional relative RMS on existing <=180s chapter proxies; not an emotion/laugh detector.
# STORY_AUDIO_ENERGY=1

# Speech-aware final boundary/pacing validation. Set 0 for legacy generation.
# PACING_ENABLED=1
# fast, balanced, emotional, educational; also selectable in the dashboard.
# PACING_MODE=balanced
# Optional conservative shortening of measured quiet gaps between complete
# same-identified-speaker sentences. Emotional/comedy beats and reactions remain.
# PACING_TRIM_SILENCE=0
# Explicitly permit an intentionally incomplete final sentence; off by default.
# PACING_ALLOW_INCOMPLETE_END=0

# Optional visual identity; unset/none preserves existing rendering choices.
# VIDEO_TEMPLATES_ENABLED=1
# VIDEO_TEMPLATE=none
# Starters: creator-energy, minimal-studio, story-focus, podcast, challenge.
# Custom templates are saved per project by the existing timeline editor.

# Measured final audio mastering (FFmpeg loudnorm / EBU R128).
# Default Natural: -16 LUFS, -2 dBTP verified after AAC; no fades or denoising.
# Set AUDIO_MASTERING=0 for the legacy fixed filter, or AUDIO_NORMALIZE=0
# to disable both normalization paths. Original preset bypasses mastering.
# AUDIO_MASTERING=1
# AUDIO_NORMALIZE=1
# AUDIO_PRESET=natural
# AUDIO_TARGET_LUFS=-16
# AUDIO_TRUE_PEAK=-2
# AUDIO_FADE_SECONDS=0
# AUDIO_NOISE_REDUCTION=0

# Professional caption placement uses three output frames and a local OpenCV
# detector, cached per output file. Set 0 for layout-safe placement only.
# CAPTION_FACE_PLACEMENT=1
# FFmpeg subtitle burn timeout in seconds (clamped to 30..900).
# CAPTION_RENDER_TIMEOUT=300

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Local NVIDIA GPU: auto-detected when these are omitted.
# Recommended for RTX 2050/3050/4050-class 4–6 GB VRAM:
# WHISPER_MODEL=small
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16
# CPU fallback: WHISPER_DEVICE=cpu WHISPER_COMPUTE=int8
# Larger GPUs can use: WHISPER_MODEL=large-v3-turbo

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# NVIDIA GPU: auto probes NVENC; falls back to x264 if unavailable.
# FFMPEG_ENCODER=auto

# Smart reframing preserves the full source in wide/no-face scenes and uses
# a source-derived blurred backdrop instead of generated black padding.
# Set 0 to restore the legacy GENERAL foreground zoom and disable the new
# context/coverage routing. Crop validation remains enabled in either mode.
# SMART_REFRAME=1

# Explicit full-HD delivery for vertical reframing (1080x1920).
# source retains the historical resolution floor and keeps larger sources.
# REFRAME_OUTPUT_SIZE=fullhd

# Anchor new ASR timestamps to observed container audio start times (FFprobe).
# Set to 0 to retain the legacy decoded-audio clock. Existing cached timing is unchanged.
# CAPTION_MEDIA_CLOCK=1

# TASK-003: timestamped, shot-local camera paths (1 default; 0 = dense hold keys).
# REFRAME_KEYFRAMES=1
# Throttled existing-YOLO check for bodies/selected objects cut by a face crop.
# Disable to avoid this additional local inference; face/scene routing remains.
# REFRAME_SUBJECT_CONTEXT=1
# Only labels supported by the installed YOLO model are considered. Empty = bodies only.
# REFRAME_OBJECT_CLASSES=bicycle,sports ball,skateboard,surfboard,tennis racket,laptop,tv
# SMART_REFRAME=0 retains legacy context/zoom policy. No dark-pixel replacement.

# Bottom caption reserve as a fraction of output height, bounded to 0.05-0.35.
# Moves text, never the face crop. Clean captions default to 0.20; classic
# captions keep their historical margin unless this is explicitly configured.
# Split captions remain at the seam between speakers.
# CAPTION_SAFE_BOTTOM_RATIO=0.20

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# ---------------------------------------------------------------------------
# Privacy, retention and access control (GDPR remediation, 4-sep-2026)
# ---------------------------------------------------------------------------

# Absolute base URL of the API as the internet reaches it. Already used for the
# absolute clip URLs in webhook payloads; now also required to build the
# unsubscribe link that goes in the out-of-minutes email. Without it that email
# falls back to "reply to unsubscribe".
# PUBLIC_API_URL=https://api.openshorts.app

# /videos and /thumbnails are authenticated endpoints, not static mounts.
# MEDIA_TOKEN_TTL_SECONDS: life of the per-user token the dashboard appends to
#   <video src> / <img src> URLs (default 43200 = 12 h).
# MEDIA_URL_TTL_SECONDS: life of the path-signed capability handed to consumers
#   that cannot send a header — webhook payloads and MCP tool results
#   (default 86400 = 24 h).
# MEDIA_TOKEN_TTL_SECONDS=43200
# MEDIA_URL_TTL_SECONDS=86400

# Retention for the two kinds of file that had none. Thumbnails and the frames
# sampled to make them are close-ups of a real person; the clock runs from the
# last download. Uploaded actor photos die with the job that used them.
# THUMBNAIL_RETENTION_SECONDS=86400
# ACTOR_UPLOAD_RETENTION_SECONDS=3600

# Per-IP rate limiting (rate_limit.py). "<max requests>/<window seconds>".
# Defaults: auth 30/600, process 60/3600, mcp 240/60. Set RATE_LIMIT_ENABLED=0
# to turn the whole thing off (self-host behind your own firewall).
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH=30/600
# RATE_LIMIT_PROCESS=60/3600
# RATE_LIMIT_MCP=240/60

# Which hop may declare the client's address in X-Forwarded-For. The Dockerfile
# defaults to the private Docker ranges; narrow it to Traefik's own address on
# the container network in production. NEVER "*": that lets any caller forge
# the IP the rate limiter and the rights declaration are keyed on.
# FORWARDED_ALLOW_IPS=10.0.1.7

# Strict-Transport-Security value sent on https responses from the API. Empty
# disables it. Do not add "preload" without understanding that it is one-way.
# HSTS_HEADER=max-age=31536000; includeSubDomains

# Encrypted PostgreSQL backups (ops/pg_backup.sh — installed and scheduled on
# the database host, not by the app). The privacy policy promises a deletion is
# gone from every copy within 30 days, which is only true while this runs.
# DATABASE_URL=postgres://user:pass@host:5432/openshorts
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_DEST=s3://openshorts-backups/pg
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# RETENTION_DAYS=30

# TASK-005: editorial score weights, normalized to 100%; heuristics, not view predictions.
# Missing metrics remain unassessed. Invalid environment configuration uses defaults.
# CLIP_SCORE_WEIGHTS={"hook":25,"story":25,"engagement":20,"visual":15,"pacing":10,"ending":5}

# TASK-006: saved timeline, waveform/scenes, cached previews and selective renders.
# Opening headlines: the dashboard's auto-hook toggle still controls AUTO_HOOK.
# AUTO_HOOK=0 disables automatic headlines without disabling captions.
# Automatic text quotes complete retained opening speech; missing context skips it.
# AUTO_HOOK_STYLE=classic
# AUTO_HOOK_SECONDS=3
# Manual headline animation/timing is saved per clip, independent of captions.
# Set to 0 to retain only the classic editor routes/controls.
# EDITOR_TIMELINE_ENABLED=1

# Scene-aware editing director (opt-in; existing generation remains the default).
# Freeze the existing v2 scene/tracking analysis into a validated EDL for final/preview.
# EDIT_DIRECTOR=1
# auto uses retained Gemini editing_kind when available; otherwise general.
# Choices: auto, challenge, emotional, comedy, podcast, educational, general.
# EDIT_DIRECTOR_STRATEGY=auto
# Directed portrait output defaults to 1080x1920. Explicit source keeps the old size policy.
# REFRAME_OUTPUT_SIZE=fullhd
